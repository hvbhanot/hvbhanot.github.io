  <script>
    import * as THREE from 'three';

    const canvas = document.querySelector('#portfolio-scene');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (canvas instanceof HTMLCanvasElement) {
      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        preserveDrawingBuffer: true,
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
      camera.position.set(0, 0, 9);

      const group = new THREE.Group();
      scene.add(group);

      const C = {
        violet: new THREE.Color('#a78bfa'),
        cyan:   new THREE.Color('#22d3ee'),
        lime:   new THREE.Color('#bef264'),
        white:  new THREE.Color('#ffffff'),
      };

      // Neural graph: layers of nodes, fully connected between layers
      const layerDefs = [
        { y:  2.4, n: 3, color: C.violet },
        { y:  0.9, n: 6, color: C.cyan   },
        { y: -0.6, n: 6, color: C.cyan   },
        { y: -2.1, n: 4, color: C.lime   },
      ];

      const nodes = [];
      const nodeGeo = new THREE.SphereGeometry(0.09, 16, 16);

      layerDefs.forEach((layer) => {
        const spread = (layer.n - 1) * 0.72;
        for (let i = 0; i < layer.n; i += 1) {
          const x = -spread / 2 + i * 0.72;
          const mat = new THREE.MeshBasicMaterial({ color: layer.color });
          const mesh = new THREE.Mesh(nodeGeo, mat);
          mesh.position.set(x, layer.y, 0);
          group.add(mesh);

          // Soft halo
          const haloMat = new THREE.SpriteMaterial({
            color: layer.color,
            transparent: true,
            opacity: 0.35,
            blending: THREE.AdditiveBlending,
          });
          const halo = new THREE.Sprite(haloMat);
          halo.scale.set(0.55, 0.55, 0.55);
          mesh.add(halo);

          nodes.push({ mesh, layer: layer.y, baseX: x, color: layer.color });
        }
      });

      // Edges between adjacent layers
      const edges = [];
      for (let L = 0; L < layerDefs.length - 1; L += 1) {
        const A = nodes.filter((n) => n.layer === layerDefs[L].y);
        const B = nodes.filter((n) => n.layer === layerDefs[L + 1].y);
        A.forEach((a) => {
          B.forEach((b) => {
            const geo = new THREE.BufferGeometry().setFromPoints([a.mesh.position, b.mesh.position]);
            const mat = new THREE.LineBasicMaterial({
              color: 0xffffff,
              transparent: true,
              opacity: 0.1,
            });
            const line = new THREE.Line(geo, mat);
            group.add(line);
            edges.push({ line, a, b, mat });
          });
        });
      }

      // Token particles flowing along random edges
      const tokens = [];
      const tokenGeo = new THREE.SphereGeometry(0.05, 10, 10);
      for (let i = 0; i < 10; i += 1) {
        const mat = new THREE.MeshBasicMaterial({ color: 0xffffff });
        const mesh = new THREE.Mesh(tokenGeo, mat);
        group.add(mesh);
        tokens.push({
          mesh,
          mat,
          edge: edges[Math.floor(Math.random() * edges.length)],
          t: Math.random(),
          speed: 0.25 + Math.random() * 0.45,
        });
      }

      // Dust particles
      const pts = 240;
      const posArr = new Float32Array(pts * 3);
      for (let i = 0; i < pts; i += 1) {
        const r = 4.2 + Math.random() * 4;
        const t = Math.random() * Math.PI * 2;
        const p = Math.acos(2 * Math.random() - 1);
        posArr[i * 3]     = r * Math.sin(p) * Math.cos(t);
        posArr[i * 3 + 1] = r * Math.sin(p) * Math.sin(t) * 0.6;
        posArr[i * 3 + 2] = r * Math.cos(p);
      }
      const ptGeo = new THREE.BufferGeometry();
      ptGeo.setAttribute('position', new THREE.BufferAttribute(posArr, 3));
      const dust = new THREE.Points(
        ptGeo,
        new THREE.PointsMaterial({
          size: 0.02,
          color: '#a78bfa',
          transparent: true,
          opacity: 0.5,
          depthWrite: false,
        }),
      );
      scene.add(dust);

      const pointer = { x: 0, y: 0 };
      window.addEventListener('pointermove', (event) => {
        pointer.x = (event.clientX / window.innerWidth - 0.5) * 2;
        pointer.y = (event.clientY / window.innerHeight - 0.5) * 2;
      });

      const resize = () => {
        const { clientWidth, clientHeight } = canvas;
        renderer.setSize(clientWidth, clientHeight, false);
        camera.aspect = clientWidth / Math.max(clientHeight, 1);
        camera.updateProjectionMatrix();
      };
      const ro = new ResizeObserver(resize);
      ro.observe(canvas);
      resize();

      const tmp = new THREE.Vector3();
      const clock = new THREE.Clock();
      const render = () => {
        const time = clock.getElapsedTime();
        const speed = reducedMotion ? 0.1 : 1;
        const dt = clock.getDelta();

        group.rotation.y = Math.sin(time * 0.22 * speed) * 0.4 + pointer.x * 0.3;
        group.rotation.x = Math.cos(time * 0.17 * speed) * 0.12 + pointer.y * 0.12;
        dust.rotation.y = time * 0.03 * speed;

        // Pulse nodes
        nodes.forEach((n, i) => {
          const s = 1 + Math.sin(time * 1.5 * speed + i * 0.6) * 0.12;
          n.mesh.scale.setScalar(s);
        });

        // Animate edge opacity (traveling activity)
        edges.forEach((e, i) => {
          const wave = 0.08 + 0.15 * Math.max(0, Math.sin(time * 0.8 * speed + i * 0.15));
          e.mat.opacity = wave;
        });

        // Token particles
        tokens.forEach((tk) => {
          tk.t += dt * tk.speed * speed;
          if (tk.t >= 1) {
            tk.t = 0;
            tk.edge = edges[Math.floor(Math.random() * edges.length)];
            tk.mat.color.copy(Math.random() > 0.5 ? C.violet : (Math.random() > 0.5 ? C.cyan : C.lime));
          }
          const a = tk.edge.a.mesh.position;
          const b = tk.edge.b.mesh.position;
          tmp.copy(a).lerp(b, tk.t);
          tk.mesh.position.copy(tmp);
          tk.mat.opacity = Math.sin(tk.t * Math.PI) * 1.2;
          tk.mat.transparent = true;
        });

        renderer.render(scene, camera);
        window.requestAnimationFrame(render);
      };
      render();
    }
  </script>
</Base>
