---
import Base from '../layouts/Base.astro';
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="hero__eyebrow reveal reveal-1">CS · TAMU–Corpus Christi · 2026</p>
      <h1 class="hero__title reveal reveal-2">
        Building <em>research tools</em><br />for AI systems<br />that matter.
      </h1>
      <p class="hero__lede reveal reveal-3">
        I'm Harsh — a CS undergrad working at the seam between machine learning and
        scientific computing. I fine-tune coding models for population-genetics
        simulators, build CTF-solving agents, and ship infrastructure that turns
        research ideas into reproducible experiments.
      </p>
      <div class="hero__meta reveal reveal-4">
        <span><strong>focus</strong> &nbsp; AI systems / ML research</span>
        <span><strong>minor</strong> &nbsp; applied math</span>
        <span><strong>next</strong> &nbsp; MS CS @ TTU, fall 2026</span>
      </div>
    </div>
  </section>

  <!-- About -->
  <section data-counted id="about">
    <div class="container narrow">
      <p class="section-label">About</p>
      <h2 class="section-title">A builder, first. <em>A researcher, by training.</em></h2>
      <div class="about">
        <p>
          I'm finishing a BS in Computer Science with an Applied Math minor at Texas
          A&amp;M Corpus Christi, where I founded
          <a href="#">Islanders Research in AI</a> and serve as an Intel Student
          Brand Ambassador. My work sits in three overlapping circles: machine
          learning, cybersecurity, and the messy infrastructure that makes science
          actually reproducible.
        </p>
        <p>
          Most of my recent time has gone into fine-tuning open-weight coding models
          on Eidos — the scripting language for the
          <a href="https://messerlab.org/slim/">SLiM</a> evolutionary simulator —
          and into a multi-agent CTF solver that runs entirely on local Ollama. I
          also build smaller things constantly: skills, agents, gateways, study
          tools. I think the best way to understand a system is to rebuild it
          badly, then better.
        </p>
        <p>
          I'm headed to Texas Tech University this fall for an MS in Computer
          Science, where I'll be focusing on ML systems and applied AI for
          scientific computing. If any of this sounds adjacent to your work,
          <a href="#contact">say hi</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Education -->
  <section data-counted id="education">
    <div class="container">
      <p class="section-label">Education</p>
      <h2 class="section-title">Where I'm <em>learning</em>.</h2>

      <ol class="exp-list">
        <li class="exp-item">
          <div class="exp-item__date">2022 — 2026</div>
          <div>
            <h3 class="exp-item__role">B.S. Computer Science</h3>
            <p class="exp-item__org">
              <strong>Texas A&amp;M University–Corpus Christi</strong> ·
              Specialization in Cybersecurity · Minor in Applied Mathematics
            </p>
            <p class="exp-item__desc">
              Dean's List standing. Coursework spans machine learning, digital
              forensics, software engineering, linear algebra, and graduate-level
              advanced topics in security and AI systems. Active in research
              alongside Dr. Wenlu Wang, where I'm focused on understanding AI
              through the math underneath it, and through Islanders Research in
              AI, the student org I founded on campus.
            </p>
            <div class="exp-item__tags">
              <span class="tag">Dean's List</span>
              <span class="tag">Cybersecurity</span>
              <span class="tag">Applied Math</span>
            </div>
          </div>
        </li>

        <li class="exp-item">
          <div class="exp-item__date">fall 2026 — incoming</div>
          <div>
            <h3 class="exp-item__role">M.S. Computer Science</h3>
            <p class="exp-item__org">
              <strong>Texas Tech University</strong> · Lubbock, TX
            </p>
            <p class="exp-item__desc">
              Starting fall 2026. Plan to focus on ML systems, applied AI for
              scientific computing, and efficient fine-tuning of language models
              for domain-specific code.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Experience -->
  <section data-counted id="experience">
    <div class="container">
      <p class="section-label">Experience</p>
      <h2 class="section-title">Where I've <em>shipped</em>.</h2>

      <ol class="exp-list">
        <li class="exp-item">
          <div class="exp-item__date">2025 — present</div>
          <div>
            <h3 class="exp-item__role">Undergraduate Researcher</h3>
            <p class="exp-item__org">
              <strong>Computational Genetics &amp; AI Systems</strong> · TAMU–CC
            </p>
            <p class="exp-item__desc">
              Designing agent-based workflows that automate SLiM parameter sweeps
              and outcome analysis across population-genetics runs. Building
              Python pipelines that parse SLiM outputs, track mutation dynamics
              across generations, and fine-tuning Qwen-coder models with LoRA on
              domain-specific Eidos corpora for experiment generation and
              summarization.
            </p>
            <div class="exp-item__tags">
              <span class="tag">SLiM</span>
              <span class="tag">LoRA</span>
              <span class="tag">Unsloth</span>
              <span class="tag">H100</span>
            </div>
          </div>
        </li>

        <li class="exp-item">
          <div class="exp-item__date">may — aug 2024</div>
          <div>
            <h3 class="exp-item__role">AI &amp; ML Intern</h3>
            <p class="exp-item__org"><strong>DataEssenceAI</strong> · Houston, TX</p>
            <p class="exp-item__desc">
              Developed and evaluated PyTorch and OpenCV models for market trend
              analysis and predictive modeling. Systematic hyperparameter tuning
              cut training time by ~20% and improved predictive accuracy by ~10%.
              Worked alongside data science and DevOps on testing and deployment.
            </p>
            <div class="exp-item__tags">
              <span class="tag">PyTorch</span>
              <span class="tag">OpenCV</span>
              <span class="tag">MLOps</span>
            </div>
          </div>
        </li>

        <li class="exp-item">
          <div class="exp-item__date">2023 — present</div>
          <div>
            <h3 class="exp-item__role">Founder &amp; Vice President</h3>
            <p class="exp-item__org"><strong>Islanders Research in AI</strong> · TAMU–CC</p>
            <p class="exp-item__desc">
              Founded a student AI research org from zero — set the structure,
              vision, and recurring programming. Run workshops on ML fundamentals,
              research tooling, reproducibility, and career development; mentor
              students from project ideation through implementation and
              presentation.
            </p>
          </div>
        </li>

        <li class="exp-item">
          <div class="exp-item__date">ongoing</div>
          <div>
            <h3 class="exp-item__role">Student Brand Ambassador</h3>
            <p class="exp-item__org"><strong>Intel Corporation</strong></p>
            <p class="exp-item__desc">
              Represent Intel's developer and AI hardware ecosystem to the TAMU–CC
              community — promoting AI accelerators, dev toolkits, and student
              programs.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Selected Work -->
  <section data-counted id="work">
    <div class="container">
      <p class="section-label">Selected Work</p>
      <h2 class="section-title">Things I've <em>made</em>.</h2>

      <ol class="proj-list">
        <li>
          <a href="https://huggingface.co/hvbhanot" class="proj-item" target="_blank" rel="noopener">
            <span class="proj-item__num">01</span>
            <div class="proj-item__main">
              <h3 class="proj-item__title">SLiM Fine-Tuning Pipeline</h3>
              <p class="proj-item__desc">
                A full Python package for benchmarking LLM-generated SLiM/Eidos
                code on H100. Tokenizer-aware loading, two-pass error correction,
                Excel benchmark output, and a published LoRA adapter on Hugging Face.
              </p>
              <div class="proj-item__tags">
                <span>python</span><span>unsloth</span><span>trl</span><span>qwen2.5-coder</span>
              </div>
            </div>
            <span class="proj-item__arrow">↗</span>
          </a>
        </li>

        <li>
          <a href="https://github.com/hvbhanot" class="proj-item" target="_blank" rel="noopener">
            <span class="proj-item__num">02</span>
            <div class="proj-item__main">
              <h3 class="proj-item__title">Professor Tux</h3>
              <p class="proj-item__desc">
                AI cybersecurity teaching assistant. FastAPI backend, ChromaDB
                RAG over course materials, pluggable teaching modes via markdown
                with YAML frontmatter. Runs locally on Jetson Orin Nano via
                Ollama.
              </p>
              <div class="proj-item__tags">
                <span>fastapi</span><span>chromadb</span><span>ollama</span><span>jetson</span>
              </div>
            </div>
            <span class="proj-item__arrow">↗</span>
          </a>
        </li>

        <li>
          <a href="https://github.com/hvbhanot" class="proj-item" target="_blank" rel="noopener">
            <span class="proj-item__num">03</span>
            <div class="proj-item__main">
              <h3 class="proj-item__title">ctf_agent</h3>
              <p class="proj-item__desc">
                Multi-agent CTF solver. ReAct loop with a planner, domain
                specialists for recon/exploit/crypto/reverse/forensics, and a
                verifier. 22 tool wrappers, scratchpad memory, JSON persistence,
                Ollama-only backend.
              </p>
              <div class="proj-item__tags">
                <span>python</span><span>react-agents</span><span>ollama</span><span>ctf</span>
              </div>
            </div>
            <span class="proj-item__arrow">↗</span>
          </a>
        </li>

        <li>
          <a href="https://aisenate.pro" class="proj-item" target="_blank" rel="noopener">
            <span class="proj-item__num">04</span>
            <div class="proj-item__main">
              <h3 class="proj-item__title">AI Senate</h3>
              <p class="proj-item__desc">
                Multi-model AI debate and consensus platform. Several frontier
                models argue a prompt out, critique each other's reasoning, and
                converge on a synthesized answer. FastAPI + React 19, client-side
                IndexedDB persistence, deployed on Railway at aisenate.pro.
              </p>
              <div class="proj-item__tags">
                <span>fastapi</span><span>react</span><span>indexeddb</span><span>railway</span>
              </div>
            </div>
            <span class="proj-item__arrow">↗</span>
          </a>
        </li>

        <li>
          <a href="https://github.com/hvbhanot/FNN" class="proj-item" target="_blank" rel="noopener">
            <span class="proj-item__num">05</span>
            <div class="proj-item__main">
              <h3 class="proj-item__title">Neural Network from Scratch</h3>
              <p class="proj-item__desc">
                Multi-layer feedforward network in pure NumPy — no frameworks.
                ReLU activations, softmax output, hand-derived backprop. 90%+
                accuracy on Iris. Built it to make sure I actually understood
                the math.
              </p>
              <div class="proj-item__tags">
                <span>numpy</span><span>backprop</span><span>from-scratch</span>
              </div>
            </div>
            <span class="proj-item__arrow">↗</span>
          </a>
        </li>

        <li>
          <a href="https://github.com/hvbhanot/RestAPI" class="proj-item" target="_blank" rel="noopener">
            <span class="proj-item__num">06</span>
            <div class="proj-item__main">
              <h3 class="proj-item__title">Go REST API + JWT</h3>
              <p class="proj-item__desc">
                JWT-authenticated REST API with full CRUD, SQLite backend, clean
                middleware architecture. An excuse to dig into Go's concurrency
                model for high-throughput backends.
              </p>
              <div class="proj-item__tags">
                <span>go</span><span>gin</span><span>jwt</span><span>sqlite</span>
              </div>
            </div>
            <span class="proj-item__arrow">↗</span>
          </a>
        </li>
      </ol>
    </div>
  </section>

  <!-- Stack -->
  <section data-counted id="stack">
    <div class="container">
      <p class="section-label">Stack</p>
      <h2 class="section-title">Tools I <em>actually</em> use.</h2>

      <div class="skills-grid">
        <div class="skill-group">
          <h3 class="skill-group__label">Languages</h3>
          <ul>
            <li>Python</li>
            <li>Go</li>
            <li>C++</li>
            <li>Bash / Shell</li>
            <li>SQL</li>
            <li>TypeScript</li>
          </ul>
        </div>

        <div class="skill-group">
          <h3 class="skill-group__label">AI / ML</h3>
          <ul>
            <li>PyTorch</li>
            <li>Hugging Face / Transformers</li>
            <li>PEFT / LoRA / Unsloth</li>
            <li>TRL / SFT</li>
            <li>scikit-learn</li>
            <li>OpenCV</li>
          </ul>
        </div>

        <div class="skill-group">
          <h3 class="skill-group__label">Systems</h3>
          <ul>
            <li>Linux / Bash</li>
            <li>Git / version control</li>
            <li>FastAPI / REST / JWT</li>
            <li>Docker</li>
            <li>Ollama / local inference</li>
            <li>Jetson / edge deployment</li>
          </ul>
        </div>

        <div class="skill-group">
          <h3 class="skill-group__label">Research</h3>
          <ul>
            <li>SLiM / Eidos</li>
            <li>Reproducible pipelines</li>
            <li>Experiment tracking</li>
            <li>LaTeX / IEEE writing</li>
            <li>Statistical methods</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section data-counted id="contact">
    <div class="container narrow">
      <p class="section-label">Contact</p>
      <h2 class="section-title">Let's <em>talk</em>.</h2>

      <div class="contact">
        <p class="contact__lede">
          Open to research collaborations, internships, and roles in AI
          systems or ML engineering. <em>I read everything.</em>
        </p>

        <div class="contact__links">
          <a class="contact-link" href="mailto:hvbhanot1@gmail.com">
            <span class="contact-link__label">Email</span>
            <span class="contact-link__value">hvbhanot1@gmail.com</span>
            <span class="contact-link__arrow">↗</span>
          </a>
          <a class="contact-link" href="https://linkedin.com/in/hvbhanot" target="_blank" rel="noopener">
            <span class="contact-link__label">LinkedIn</span>
            <span class="contact-link__value">/in/hvbhanot</span>
            <span class="contact-link__arrow">↗</span>
          </a>
          <a class="contact-link" href="https://github.com/hvbhanot" target="_blank" rel="noopener">
            <span class="contact-link__label">GitHub</span>
            <span class="contact-link__value">@hvbhanot</span>
            <span class="contact-link__arrow">↗</span>
          </a>
          <a class="contact-link" href="https://huggingface.co/hvbhanot" target="_blank" rel="noopener">
            <span class="contact-link__label">HF</span>
            <span class="contact-link__value">@hvbhanot</span>
            <span class="contact-link__arrow">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
