---
import Base from '../layouts/Base.astro';
---

<Base>
  <!-- ────────── HERO ────────── -->
  <section class="hero" aria-labelledby="hero-title">
    <canvas id="portfolio-scene" class="hero__scene" aria-hidden="true"></canvas>
    <div class="hero__glow" aria-hidden="true"></div>

    <div class="container hero__inner">
      <div class="hero__copy">
        <h1 id="hero-title" class="hero__title reveal reveal-1">
          AI systems<br />for research.
        </h1>
        <p class="hero__lede reveal reveal-2">
          I fine-tune coding models for population-genetics simulators, build
          local multi-agent CTF solvers, and turn research ideas into
          reproducible infrastructure.
        </p>
        <div class="hero__ctas reveal reveal-3">
          <a class="btn btn--primary" href="#work">
            View work
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href="/thoughts">
            Read notes
          </a>
        </div>
        <div class="hero__meta reveal reveal-4">
          <span><strong>Now</strong> SLiM / Eidos fine-tuning</span>
          <span><strong>Next</strong> MS CS · Texas Tech · 2026</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ────────── LOGOS STRIP ────────── -->
  <section class="logos" aria-label="Affiliations and tools">
    <div class="container">
      <p class="logos__label">Work and research anchored across</p>
      <ul class="logos__row">
        <li>TAMU&ndash;CC</li>
        <li>Texas Tech</li>
        <li>Intel</li>
        <li>Hugging Face</li>
        <li>NVIDIA</li>
        <li>SLiM</li>
        <li>Ollama</li>
        <li>DataEssenceAI</li>
      </ul>
    </div>
  </section>

  <!-- ────────── INTEGRATE TONIGHT → FINE-TUNE TONIGHT ────────── -->
  <section id="tonight">
    <div class="container">
      <div class="section-head">
        <div class="feat-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 7h16M4 12h16M4 17h10" stroke-linecap="round" />
          </svg>
        </div>
        <h2 class="section-title">Fine-tune <em>tonight</em>.</h2>
        <p class="section-lede">
          A repeatable pipeline so I can go from a raw Eidos corpus to a
          published LoRA adapter overnight &mdash; tokenizer-aware loading,
          two-pass repair, Excel output.
        </p>
      </div>

      <ul class="feat-tabs" role="tablist">
        <li aria-current="true">unsloth</li>
        <li>transformers</li>
        <li>trl</li>
        <li>peft</li>
        <li>torch</li>
        <li>datasets</li>
        <li>evaluate</li>
      </ul>

      <div class="code-card">
        <div class="code-card__bar">
          <span class="code-card__dot"></span>
          <span class="code-card__dot"></span>
          <span class="code-card__dot"></span>
        </div>
        <div class="code-card__tabs">
          <span class="code-card__tab" aria-current="true">train.py</span>
          <span class="code-card__tab">config.yaml</span>
          <span class="code-card__tab">adapter_readme.md</span>
          <span class="code-card__tab">eval.py</span>
        </div>
        <div class="code-card__body">
<pre><span class="tok-kw">from</span> unsloth <span class="tok-kw">import</span> FastLanguageModel
<span class="tok-kw">from</span> trl <span class="tok-kw">import</span> SFTTrainer
<span class="tok-kw">from</span> datasets <span class="tok-kw">import</span> load_dataset

model, tok = FastLanguageModel.<span class="tok-fn">from_pretrained</span>(
  <span class="tok-prop">model_name</span> = <span class="tok-str">"unsloth/qwen2.5-coder-7b-bnb-4bit"</span>,
  <span class="tok-prop">max_seq_length</span> = <span class="tok-num">4096</span>,
  <span class="tok-prop">load_in_4bit</span> = <span class="tok-kw">True</span>,
)

model = FastLanguageModel.<span class="tok-fn">get_peft_model</span>(
  model, <span class="tok-prop">r</span> = <span class="tok-num">32</span>, <span class="tok-prop">lora_alpha</span> = <span class="tok-num">32</span>,
  <span class="tok-prop">target_modules</span> = [<span class="tok-str">"q_proj"</span>, <span class="tok-str">"k_proj"</span>, <span class="tok-str">"v_proj"</span>, <span class="tok-str">"o_proj"</span>],
)

ds = <span class="tok-fn">load_dataset</span>(<span class="tok-str">"hvbhanot/slim-eidos-pairs"</span>, <span class="tok-prop">split</span>=<span class="tok-str">"train"</span>)

<span class="tok-fn">SFTTrainer</span>(model, <span class="tok-prop">tokenizer</span>=tok, <span class="tok-prop">train_dataset</span>=ds).<span class="tok-fn">train</span>()
model.<span class="tok-fn">push_to_hub</span>(<span class="tok-str">"hvbhanot/slim-coder-lora"</span>)  <span class="tok-cmt"># ⇢ 1 H100, ~2h</span></pre>
        </div>
        <div class="code-card__foot">
          <span>adapter · qwen2.5-coder-7b</span>
          <span class="tok-ok">● pushed</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ────────── FIRST-CLASS RESEARCH WORKFLOW ────────── -->
  <section>
    <div class="container">
      <div class="section-head section-head--left">
        <h2 class="section-title">First-class<br />research workflow.</h2>
        <p class="section-lede">
          Reproducibility isn&rsquo;t a vibe &mdash; it&rsquo;s a checklist.
          Every run is versioned, every artifact is small enough to ship, and
          every evaluation writes to disk.
        </p>
      </div>

      <div class="feat-grid">
        <div class="feat-card">
          <div class="feat-card__media">
            <span class="mock-pill">
              <span class="mock-pill__dot" aria-hidden="true"></span>
              eval.run &middot; <b style="color:var(--ink)">pass@1 · 0.71</b>
            </span>
          </div>
          <div class="feat-card__body">
            <p class="feat-card__title">Deterministic evals</p>
            <p class="feat-card__desc">
              Fixed seeds, cached corpora, and a two-pass repair step so the
              same inputs always yield the same pass@k &mdash; no silent drift
              between runs.
            </p>
          </div>
        </div>

        <div class="feat-card">
          <div class="feat-card__media">
            <div class="mock-lines" role="presentation">
              <span><b>POST</b> /run <span class="tok-mute">200</span></span>
              <span><b>GET</b> /adapters/slim-coder-lora</span>
              <span><b>GET</b> /metrics <span class="tok-mute">200</span></span>
            </div>
          </div>
          <div class="feat-card__body">
            <p class="feat-card__title">Local inference endpoints</p>
            <p class="feat-card__desc">
              Every model I train also ships a FastAPI runner &mdash; so the
              same adapter I pushed tonight is serving requests on a Jetson
              Orin by morning.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ────────── BUILD WITH OPEN MODELS (big code card) ────────── -->
  <section>
    <div class="container">
      <div class="section-head">
        <div class="feat-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8 9l-4 3 4 3M16 9l4 3-4 3M14 6l-4 12" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <h2 class="section-title">Build with <em>open models</em>.</h2>
        <p class="section-lede">
          Every piece of inference runs locally. Ollama, llama.cpp, vLLM &mdash;
          whichever runtime makes the agent reproducible on someone else&rsquo;s
          box.
        </p>
      </div>

      <div class="code-card">
        <div class="code-card__bar">
          <span class="code-card__dot"></span>
          <span class="code-card__dot"></span>
          <span class="code-card__dot"></span>
        </div>
        <div class="code-card__tabs">
          <span class="code-card__tab" aria-current="true">ctf_agent/plan.py</span>
          <span class="code-card__tab">tools.py</span>
          <span class="code-card__tab">verifier.py</span>
        </div>
        <div class="code-card__body">
<pre><span class="tok-kw">from</span> ollama <span class="tok-kw">import</span> chat
<span class="tok-kw">from</span> ctf_agent <span class="tok-kw">import</span> Planner, Verifier, TOOLS

planner  = <span class="tok-fn">Planner</span>(<span class="tok-prop">model</span>=<span class="tok-str">"qwen2.5-coder:7b"</span>)
verifier = <span class="tok-fn">Verifier</span>(<span class="tok-prop">model</span>=<span class="tok-str">"llama3.1:8b"</span>)

<span class="tok-kw">def</span> <span class="tok-fn">solve</span>(chal):
    plan = planner.<span class="tok-fn">decompose</span>(chal)
    <span class="tok-kw">for</span> step <span class="tok-kw">in</span> plan:
        out = TOOLS[step.tool].<span class="tok-fn">run</span>(step.args)
        <span class="tok-kw">if</span> verifier.<span class="tok-fn">accepts</span>(step, out):
            <span class="tok-kw">yield</span> out
        <span class="tok-kw">else</span>:
            plan.<span class="tok-fn">replan</span>(step, out)   <span class="tok-cmt"># scratchpad loop</span></pre>
        </div>
        <div class="code-card__foot">
          <span>22 tool wrappers · scratchpad memory · JSON persistence</span>
          <span class="tok-ok">● offline</span>
        </div>
      </div>
    </div>
  </section>

