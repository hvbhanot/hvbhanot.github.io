  <script>
    import * as THREE from 'three';

    const canvas = document.querySelector('#portfolio-scene');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (canvas instanceof HTMLCanvasElement) {
      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        preserveDrawingBuffer: true,
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(36, 1, 0.1, 100);
      camera.position.set(0, 0.2, 9);

      const group = new THREE.Group();
      scene.add(group);

      // Glass/metal cube cluster (Resend-style Rubik aesthetic)
      const cubeMat = new THREE.MeshPhysicalMaterial({
        color: '#e2e2e2',
        metalness: 0.88,
        roughness: 0.22,
        clearcoat: 0.9,
        clearcoatRoughness: 0.1,
        emissive: '#1a1a1a',
        emissiveIntensity: 0.18,
      });
      const edgeMat = new THREE.LineBasicMaterial({
        color: '#a0a0a0',
        transparent: true,
        opacity: 0.45,
      });

      const cluster = new THREE.Group();
      const size = 1.0;
      const gap = 0.06;
      for (let x = -1; x <= 1; x += 1) {
        for (let y = -1; y <= 1; y += 1) {
          for (let z = -1; z <= 1; z += 1) {
            const geo = new THREE.BoxGeometry(size, size, size);
            const box = new THREE.Mesh(geo, cubeMat);
            box.position.set(
              x * (size + gap),
              y * (size + gap),
              z * (size + gap),
            );
            const edges = new THREE.LineSegments(new THREE.EdgesGeometry(geo), edgeMat);
            box.add(edges);
            cluster.add(box);
          }
        }
      }
      cluster.scale.setScalar(1.05);
      cluster.rotation.set(-0.35, 0.7, 0.15);
      group.add(cluster);

      // Ambient halo ring
      const halo = new THREE.Mesh(
        new THREE.TorusGeometry(3.3, 0.009, 8, 200),
        new THREE.MeshBasicMaterial({ color: '#ffffff', transparent: true, opacity: 0.09 }),
      );
      halo.rotation.x = Math.PI / 2.2;
      group.add(halo);

      const halo2 = new THREE.Mesh(
        new THREE.TorusGeometry(4.1, 0.006, 8, 200),
        new THREE.MeshBasicMaterial({ color: '#a78bfa', transparent: true, opacity: 0.25 }),
      );
      halo2.rotation.x = Math.PI / 1.8;
      halo2.rotation.z = 0.4;
      group.add(halo2);

      // Dust particles
      const pts = 380;
      const posArr = new Float32Array(pts * 3);
      for (let i = 0; i < pts; i += 1) {
        const r = 4.2 + Math.random() * 5.2;
        const t = Math.random() * Math.PI * 2;
        const p = Math.acos(2 * Math.random() - 1);
        posArr[i * 3] = r * Math.sin(p) * Math.cos(t);
        posArr[i * 3 + 1] = r * Math.sin(p) * Math.sin(t) * 0.5;
        posArr[i * 3 + 2] = r * Math.cos(p);
      }
      const ptGeo = new THREE.BufferGeometry();
      ptGeo.setAttribute('position', new THREE.BufferAttribute(posArr, 3));
      const dust = new THREE.Points(
        ptGeo,
        new THREE.PointsMaterial({
          size: 0.02,
          color: '#ffffff',
          transparent: true,
          opacity: 0.38,
          depthWrite: false,
        }),
      );
      scene.add(dust);

      // Lighting
      scene.add(new THREE.AmbientLight('#ffffff', 0.4));
      const key = new THREE.DirectionalLight('#ffffff', 3);
      key.position.set(5, 5, 6);
      scene.add(key);
      const rim = new THREE.PointLight('#a78bfa', 3.2, 22);
      rim.position.set(-4, 2, -2);
      scene.add(rim);
      const under = new THREE.PointLight('#67e8f9', 1.8, 20);
      under.position.set(3, -3, 2);
      scene.add(under);

      const pointer = { x: 0, y: 0 };
      window.addEventListener('pointermove', (event) => {
        pointer.x = (event.clientX / window.innerWidth - 0.5) * 2;
        pointer.y = (event.clientY / window.innerHeight - 0.5) * 2;
      });

      const resize = () => {
        const { clientWidth, clientHeight } = canvas;
        renderer.setSize(clientWidth, clientHeight, false);
        camera.aspect = clientWidth / Math.max(clientHeight, 1);
        camera.updateProjectionMatrix();
      };
      const ro = new ResizeObserver(resize);
      ro.observe(canvas);
      resize();

      const clock = new THREE.Clock();
      const render = () => {
        const time = clock.getElapsedTime();
        const speed = reducedMotion ? 0.08 : 1;

        cluster.rotation.y = time * 0.2 * speed + pointer.x * 0.3;
        cluster.rotation.x = -0.32 + Math.sin(time * 0.35 * speed) * 0.05 + pointer.y * 0.12;
        halo.rotation.z = time * 0.08 * speed;
        halo2.rotation.z = -time * 0.05 * speed;
        dust.rotation.y = time * 0.018 * speed;

        renderer.render(scene, camera);
        window.requestAnimationFrame(render);
      };
      render();
    }
  </script>
