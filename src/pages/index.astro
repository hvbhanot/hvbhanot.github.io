---
import Base from '../layouts/Base.astro';
---

<Base>
  <!-- ────────── HERO ────────── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__glow" aria-hidden="true"></div>

    <div class="container hero__inner">
      <div class="hero__copy">
        <span class="hero__badge reveal reveal-1">
          <b>v2026.04</b> &nbsp;·&nbsp; shipping SLiM&nbsp;coder&nbsp;LoRA
        </span>
        <h1 id="hero-title" class="hero__title reveal reveal-2">
          AI systems<br />for <em>research</em>.
        </h1>
        <p class="hero__lede reveal reveal-3">
          I fine-tune coding models for population-genetics simulators, build
          local multi-agent CTF solvers, and turn research ideas into
          reproducible infrastructure.
        </p>
        <div class="hero__ctas reveal reveal-4">
          <a class="btn btn--primary" href="#work">
            View work
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href="/thoughts">Read notes</a>
        </div>
        <dl class="hero__meta reveal reveal-5">
          <div>
            <dt>Focus</dt>
            <dd>ML systems &middot; sci-computing</dd>
          </div>
          <div>
            <dt>Now</dt>
            <dd>SLiM / Eidos fine-tuning</dd>
          </div>
          <div>
            <dt>Next</dt>
            <dd>MS CS &middot; Texas Tech &middot; 2026</dd>
          </div>
        </dl>
      </div>

      <div class="hero__visual reveal reveal-3" aria-hidden="true">
        <div class="hero__halo"></div>
        <canvas id="portfolio-scene" class="hero__scene"></canvas>
      </div>
    </div>
  </section>

  <!-- ────────── LOGOS STRIP ────────── -->
  <section class="logos" aria-label="Affiliations and tools">
    <div class="container">
      <p class="logos__label">Work and research anchored across</p>
      <ul class="logos__row">
        <li>TAMU&ndash;CC</li>
        <li>Texas Tech</li>
        <li>Intel</li>
        <li>Hugging Face</li>
        <li>NVIDIA</li>
        <li>SLiM</li>
        <li>Ollama</li>
        <li>DataEssenceAI</li>
      </ul>
    </div>
  </section>

  <!-- ────────── FINE-TUNE TONIGHT ────────── -->
  <section id="tonight">
    <div class="container">
      <div class="section-head">
        <div class="feat-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" stroke-linecap="round" />
            <circle cx="12" cy="12" r="3.2" />
          </svg>
        </div>
        <h2 class="section-title">Fine-tune <em>tonight</em>.</h2>
        <p class="section-lede">
          A repeatable pipeline so I can go from a raw Eidos corpus to a
          published LoRA adapter overnight &mdash; tokenizer-aware loading,
          two-pass repair, Excel output.
        </p>
      </div>

      <ul class="feat-tabs" role="tablist">
        <li aria-current="true">unsloth</li>
        <li>transformers</li>
        <li>trl</li>
        <li>peft</li>
        <li>torch</li>
        <li>datasets</li>
        <li>evaluate</li>
      </ul>

      <div class="code-card">
        <div class="code-card__bar">
          <span class="code-card__dot"></span>
          <span class="code-card__dot"></span>
          <span class="code-card__dot"></span>
          <span class="code-card__bar-title">slim-coder &nbsp;·&nbsp; train.py</span>
        </div>
        <div class="code-card__tabs">
          <span class="code-card__tab" aria-current="true">train.py</span>
          <span class="code-card__tab">config.yaml</span>
          <span class="code-card__tab">adapter_readme.md</span>
          <span class="code-card__tab">eval.py</span>
        </div>
        <div class="code-card__body">
<pre><span class="ln"><span class="tok-kw">from</span> unsloth <span class="tok-kw">import</span> FastLanguageModel</span><span class="ln"><span class="tok-kw">from</span> trl <span class="tok-kw">import</span> SFTTrainer</span><span class="ln"><span class="tok-kw">from</span> datasets <span class="tok-kw">import</span> load_dataset</span><span class="ln"></span><span class="ln">model, tok = FastLanguageModel.<span class="tok-fn">from_pretrained</span>(</span><span class="ln">  <span class="tok-prop">model_name</span> = <span class="tok-str">"unsloth/qwen2.5-coder-7b-bnb-4bit"</span>,</span><span class="ln">  <span class="tok-prop">max_seq_length</span> = <span class="tok-num">4096</span>,</span><span class="ln">  <span class="tok-prop">load_in_4bit</span> = <span class="tok-kw">True</span>,</span><span class="ln">)</span><span class="ln"></span><span class="ln">model = FastLanguageModel.<span class="tok-fn">get_peft_model</span>(</span><span class="ln">  model, <span class="tok-prop">r</span>=<span class="tok-num">32</span>, <span class="tok-prop">lora_alpha</span>=<span class="tok-num">32</span>,</span><span class="ln">  <span class="tok-prop">target_modules</span> = [<span class="tok-str">"q_proj"</span>, <span class="tok-str">"k_proj"</span>, <span class="tok-str">"v_proj"</span>, <span class="tok-str">"o_proj"</span>],</span><span class="ln">)</span><span class="ln"></span><span class="ln">ds = <span class="tok-fn">load_dataset</span>(<span class="tok-str">"hvbhanot/slim-eidos-pairs"</span>, <span class="tok-prop">split</span>=<span class="tok-str">"train"</span>)</span><span class="ln"><span class="tok-fn">SFTTrainer</span>(model, <span class="tok-prop">tokenizer</span>=tok, <span class="tok-prop">train_dataset</span>=ds).<span class="tok-fn">train</span>()</span><span class="ln">model.<span class="tok-fn">push_to_hub</span>(<span class="tok-str">"hvbhanot/slim-coder-lora"</span>)  <span class="tok-cmt"># ⇢ 1 H100, ~2h</span></span></pre>
        </div>
        <div class="code-card__foot">
          <span>adapter &middot; qwen2.5-coder-7b</span>
          <span class="tok-ok">● pushed</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ────────── FIRST-CLASS RESEARCH WORKFLOW ────────── -->
  <section>
    <div class="container">
      <div class="section-head section-head--left">
        <h2 class="section-title">First-class<br />research workflow.</h2>
        <p class="section-lede">
          Reproducibility isn&rsquo;t a vibe &mdash; it&rsquo;s a checklist.
          Every run is versioned, every artifact is small enough to ship, and
          every evaluation writes to disk.
        </p>
      </div>

      <div class="feat-grid">
        <div class="feat-card">
          <div class="feat-card__media">
            <div class="mock-inbox" role="presentation">
              <div class="mock-inbox__row">
                <span class="mock-inbox__key">run</span>
                <span class="mock-inbox__val">slim-coder-01</span>
                <span class="mock-inbox__tag">v4</span>
              </div>
              <div class="mock-inbox__row mock-inbox__row--hi">
                <span class="mock-inbox__key">eval</span>
                <span class="mock-inbox__val">pass@1 &middot; <b>0.71</b></span>
                <span class="mock-inbox__tag mock-inbox__tag--ok">✓ ok</span>
              </div>
              <div class="mock-inbox__row">
                <span class="mock-inbox__key">seed</span>
                <span class="mock-inbox__val">1337 &middot; fixed</span>
                <span class="mock-inbox__tag">det</span>
              </div>
              <div class="mock-inbox__row">
                <span class="mock-inbox__key">size</span>
                <span class="mock-inbox__val">lora &middot; 84&nbsp;MB</span>
                <span class="mock-inbox__tag">ship</span>
              </div>
            </div>
          </div>
          <div class="feat-card__body">
            <p class="feat-card__title">Deterministic evals</p>
            <p class="feat-card__desc">
              Fixed seeds, cached corpora, and a two-pass repair step so the
              same inputs always yield the same pass@k &mdash; no silent drift
              between runs.
            </p>
          </div>
        </div>

        <div class="feat-card">
          <div class="feat-card__media">
            <div class="mock-event" role="presentation">
              <div class="mock-event__head">
                <b>webhook.event</b>
                <span>● 200</span>
              </div>
              <div style="color:var(--ink-3);">
                &#123;<br />
                &nbsp;&nbsp;<span class="tok-prop">"type"</span>: <span class="tok-str">"run.completed"</span>,<br />
                &nbsp;&nbsp;<span class="tok-prop">"adapter"</span>: <span class="tok-str">"slim-coder-lora"</span>,<br />
                &nbsp;&nbsp;<span class="tok-prop">"metrics"</span>: &#123;<br />
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="tok-prop">"pass@1"</span>: <span class="tok-num">0.71</span>,<br />
                &nbsp;&nbsp;&nbsp;&nbsp;<span class="tok-prop">"loss"</span>: <span class="tok-num">0.42</span><br />
                &nbsp;&nbsp;&#125;<br />
                &#125;
              </div>
            </div>
          </div>
          <div class="feat-card__body">
            <p class="feat-card__title">Local inference endpoints</p>
            <p class="feat-card__desc">
              Every model I train also ships a FastAPI runner &mdash; so the
              same adapter I pushed tonight is serving requests on a Jetson
              Orin by morning.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ────────── BUILD WITH OPEN MODELS ────────── -->
  <section>
    <div class="container">
      <div class="section-head">
        <div class="feat-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M8 6l-5 6 5 6M16 6l5 6-5 6M14 4l-4 16" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <h2 class="section-title">Build with <em>open models</em>.</h2>
        <p class="section-lede">
          Every piece of inference runs locally. Ollama, llama.cpp, vLLM &mdash;
          whichever runtime makes the agent reproducible on someone else&rsquo;s
          box.
        </p>
      </div>

      <div class="code-card">
        <div class="code-card__bar">
          <span class="code-card__dot"></span>
          <span class="code-card__dot"></span>
          <span class="code-card__dot"></span>
          <span class="code-card__bar-title">ctf_agent &nbsp;·&nbsp; plan.py</span>
        </div>
        <div class="code-card__tabs">
          <span class="code-card__tab" aria-current="true">plan.py</span>
          <span class="code-card__tab">tools.py</span>
          <span class="code-card__tab">verifier.py</span>
          <span class="code-card__tab">scratchpad.json</span>
        </div>
        <div class="code-card__body">
<pre><span class="ln"><span class="tok-kw">from</span> ollama <span class="tok-kw">import</span> chat</span><span class="ln"><span class="tok-kw">from</span> ctf_agent <span class="tok-kw">import</span> Planner, Verifier, TOOLS</span><span class="ln"></span><span class="ln">planner  = <span class="tok-fn">Planner</span>(<span class="tok-prop">model</span>=<span class="tok-str">"qwen2.5-coder:7b"</span>)</span><span class="ln">verifier = <span class="tok-fn">Verifier</span>(<span class="tok-prop">model</span>=<span class="tok-str">"llama3.1:8b"</span>)</span><span class="ln"></span><span class="ln"><span class="tok-kw">def</span> <span class="tok-fn">solve</span>(chal):</span><span class="ln">    plan = planner.<span class="tok-fn">decompose</span>(chal)</span><span class="ln">    <span class="tok-kw">for</span> step <span class="tok-kw">in</span> plan:</span><span class="ln">        out = TOOLS[step.tool].<span class="tok-fn">run</span>(step.args)</span><span class="ln">        <span class="tok-kw">if</span> verifier.<span class="tok-fn">accepts</span>(step, out):</span><span class="ln">            <span class="tok-kw">yield</span> out</span><span class="ln">        <span class="tok-kw">else</span>:</span><span class="ln">            plan.<span class="tok-fn">replan</span>(step, out)   <span class="tok-cmt"># scratchpad loop</span></span></pre>
        </div>
        <div class="code-card__foot">
          <span>22 tool wrappers &middot; scratchpad memory &middot; JSON persistence</span>
          <span class="tok-ok">● offline</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ────────── PROJECTS ────────── -->
  <section id="work">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Selected <em>work</em>.</h2>
        <p class="section-lede">
          Research pipelines, local AI tooling, and the occasional end-to-end
          web platform &mdash; shipped with the artifacts.
        </p>
      </div>

      <div class="proj-grid">
        <a class="proj proj--wide" href="https://huggingface.co/hvbhanot" target="_blank" rel="noopener">
          <span class="proj__idx">01 &middot; pipeline</span>
          <h3>SLiM fine-tuning pipeline</h3>
          <p>
            Benchmarking and fine-tuning workflow for LLM-generated SLiM/Eidos
            code on H100, with tokenizer-aware loading, two-pass repair, Excel
            output, and a published LoRA adapter.
          </p>
          <div class="proj__meta">
            <span>python &middot; unsloth &middot; trl &middot; qwen2.5-coder</span>
            <span class="proj__arrow" aria-hidden="true">↗</span>
          </div>
        </a>

        <a class="proj" href="https://github.com/hvbhanot" target="_blank" rel="noopener">
          <span class="proj__idx">02 &middot; teaching ai</span>
          <h3>Professor Tux</h3>
          <p>
            Local AI cybersecurity teaching assistant with FastAPI, ChromaDB
            RAG, markdown teaching modes, Ollama, and Jetson Orin Nano
            deployment.
          </p>
          <div class="proj__meta">
            <span>fastapi &middot; chromadb &middot; ollama</span>
            <span class="proj__arrow" aria-hidden="true">↗</span>
          </div>
        </a>

        <a class="proj" href="https://github.com/hvbhanot" target="_blank" rel="noopener">
          <span class="proj__idx">03 &middot; agents</span>
          <h3>ctf_agent</h3>
          <p>
            Multi-agent CTF solver with planner, specialists, verifier, 22 tool
            wrappers, scratchpad memory, JSON persistence, and local inference.
          </p>
          <div class="proj__meta">
            <span>python &middot; react agents &middot; ctf</span>
            <span class="proj__arrow" aria-hidden="true">↗</span>
          </div>
        </a>

        <a class="proj" href="https://aisenate.pro" target="_blank" rel="noopener">
          <span class="proj__idx">04 &middot; platform</span>
          <h3>AI Senate</h3>
          <p>
            Multi-model debate platform where frontier models argue, critique,
            and converge on a synthesized answer with client-side persistence.
          </p>
          <div class="proj__meta">
            <span>fastapi &middot; react &middot; railway</span>
            <span class="proj__arrow" aria-hidden="true">↗</span>
          </div>
        </a>

        <a class="proj" href="https://github.com/hvbhanot/FNN" target="_blank" rel="noopener">
          <span class="proj__idx">05 &middot; from scratch</span>
          <h3>Neural net from scratch</h3>
          <p>
            Pure NumPy feedforward network with hand-derived backprop, ReLU,
            softmax output, and 90%+ Iris accuracy.
          </p>
          <div class="proj__meta">
            <span>numpy &middot; backprop &middot; math</span>
            <span class="proj__arrow" aria-hidden="true">↗</span>
          </div>
        </a>

        <a class="proj" href="https://github.com/hvbhanot/RestAPI" target="_blank" rel="noopener">
          <span class="proj__idx">06 &middot; backend</span>
          <h3>Go REST API + JWT</h3>
          <p>
            JWT-authenticated CRUD API with SQLite, clean middleware, and a
            practical dive into Go backend structure.
          </p>
          <div class="proj__meta">
            <span>go &middot; gin &middot; jwt &middot; sqlite</span>
            <span class="proj__arrow" aria-hidden="true">↗</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ────────── ABOUT + QUOTE ────────── -->
  <section id="about">
    <div class="container">
      <div class="quote">
        <div class="quote__up" aria-hidden="true">&ldquo;</div>
        <p class="quote__text">
          The real portfolio is the pipeline. Reproducibility is the product
          &mdash; the model is just the output.
        </p>
        <p class="quote__by">
          <b>Harsh Vardhan Bhanot</b> &middot; working principle
        </p>
      </div>
    </div>
  </section>

  <!-- ────────── TRAJECTORY / TIMELINE ────────── -->
  <section id="experience">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">The <em>trajectory</em>.</h2>
        <p class="section-lede">
          Where I am on the path &mdash; research roles, the org I founded, and
          what&rsquo;s on the calendar.
        </p>
      </div>

      <ol class="timeline">
        <li>
          <time>2025 &mdash; present</time>
          <div>
            <h3>Undergraduate researcher</h3>
            <p>Computational genetics and AI systems at TAMU&ndash;CC, building agent workflows, SLiM analysis pipelines, and LoRA fine-tuning runs.</p>
          </div>
        </li>
        <li>
          <time>May &mdash; Aug 2024</time>
          <div>
            <h3>AI &amp; ML intern</h3>
            <p>DataEssenceAI, Houston. Built PyTorch and OpenCV models for predictive analysis, tuning, testing, and deployment workflows.</p>
          </div>
        </li>
        <li>
          <time>2023 &mdash; present</time>
          <div>
            <h3>Founder &amp; vice president</h3>
            <p>Islanders Research in AI &mdash; a student research org for ML fundamentals, reproducibility, project mentoring, and career development.</p>
          </div>
        </li>
        <li>
          <time>2022 &mdash; 2026</time>
          <div>
            <h3>B.S. Computer Science</h3>
            <p>Texas A&amp;M University&ndash;Corpus Christi, cybersecurity specialization, applied math minor, Dean&rsquo;s List standing.</p>
          </div>
        </li>
        <li>
          <time>Fall 2026</time>
          <div>
            <h3>M.S. Computer Science</h3>
            <p>Incoming at Texas Tech University, focused on ML systems and applied AI for scientific computing.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ────────── STACK DASHBOARD ────────── -->
  <section id="stack">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Everything in the <em>toolkit</em>.</h2>
        <p class="section-lede">
          Deployed runs, compute used, and the tools in active rotation &mdash;
          chosen so the same repo runs on an H100 cluster, a Jetson Orin, and
          my laptop.
        </p>
      </div>

      <div class="panel-card">
        <div class="panel-card__bar">
          <span class="code-card__dot"></span>
          <span class="code-card__dot"></span>
          <span class="code-card__dot"></span>
          <span class="panel-card__bar-meta">stack &middot; dashboard</span>
        </div>
        <div class="panel-card__body">
          <div class="panel-card__tabs" role="tablist">
            <button aria-current="true">Training runs</button>
            <button>Compute</button>
            <button>Artifacts</button>
          </div>

          <svg class="chart" viewBox="0 0 640 220" preserveAspectRatio="none" role="img" aria-label="Monthly training runs">
            <defs>
              <linearGradient id="barGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%"  stop-color="#a78bfa" stop-opacity="0.95" />
                <stop offset="100%" stop-color="#a78bfa" stop-opacity="0.2" />
              </linearGradient>
              <linearGradient id="barGradHi" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%"  stop-color="#67e8f9" stop-opacity="1" />
                <stop offset="100%" stop-color="#67e8f9" stop-opacity="0.25" />
              </linearGradient>
            </defs>
            <g class="chart__grid">
              <line x1="0"   y1="40"  x2="640" y2="40"  />
              <line x1="0"   y1="80"  x2="640" y2="80"  />
              <line x1="0"   y1="120" x2="640" y2="120" />
              <line x1="0"   y1="160" x2="640" y2="160" />
            </g>
            <g class="chart__bar">
              <rect x="20"   y="148" width="32" height="52"  rx="4" />
              <rect x="72"   y="120" width="32" height="80"  rx="4" />
              <rect x="124"  y="110" width="32" height="90"  rx="4" />
              <rect x="176"  y="86"  width="32" height="114" rx="4" />
              <rect x="228"  y="72"  width="32" height="128" rx="4" />
              <rect x="280"  y="96"  width="32" height="104" rx="4" />
              <rect x="332"  y="60"  width="32" height="140" rx="4" />
              <rect x="384"  y="78"  width="32" height="122" rx="4" />
              <rect x="436"  y="44"  width="32" height="156" rx="4" class="chart__bar--hi" />
              <rect x="488"  y="66"  width="32" height="134" rx="4" />
              <rect x="540"  y="54"  width="32" height="146" rx="4" />
              <rect x="592"  y="38"  width="32" height="162" rx="4" class="chart__bar--hi" />
            </g>
            <g class="chart__axis">
              <text x="36"  y="214">jun</text>
              <text x="88"  y="214">jul</text>
              <text x="140" y="214">aug</text>
              <text x="192" y="214">sep</text>
              <text x="244" y="214">oct</text>
              <text x="296" y="214">nov</text>
              <text x="348" y="214">dec</text>
              <text x="400" y="214">jan</text>
              <text x="452" y="214">feb</text>
              <text x="504" y="214">mar</text>
              <text x="556" y="214">apr</text>
              <text x="608" y="214">may</text>
            </g>
          </svg>

          <dl class="chart-stats">
            <div class="chart-stats__item">
              <dt>Training runs</dt>
              <dd>184 <small>+12%</small></dd>
            </div>
            <div class="chart-stats__item">
              <dt>GPU hours</dt>
              <dd>612 <small>H100</small></dd>
            </div>
            <div class="chart-stats__item">
              <dt>Adapters shipped</dt>
              <dd>7 <small>public</small></dd>
            </div>
            <div class="chart-stats__item">
              <dt>Repos active</dt>
              <dd>14</dd>
            </div>
          </dl>

          <div class="stack-cloud" aria-label="Skills">
            <span>Python</span><span>Go</span><span>C++</span><span>TypeScript</span>
            <span>PyTorch</span><span>Transformers</span><span>PEFT / LoRA</span>
            <span>Unsloth</span><span>FastAPI</span><span>Docker</span>
            <span>Ollama</span><span>Jetson</span><span>SLiM / Eidos</span>
            <span>Linux</span><span>OpenCV</span><span>LaTeX</span>
          </div>
