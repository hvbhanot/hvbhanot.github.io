---
import Base from '../layouts/Base.astro';
---

<Base>
  <!-- ────────── HERO STATEMENT ────────── -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <p class="eyebrow eyebrow--accent reveal reveal-1" style="margin-bottom: 2.25rem;">
        — Portfolio &middot; MMXXVI
      </p>

      <div class="hero__grid">
        <div>
          <h1 id="hero-title" class="hero__statement reveal reveal-2">
            <b>Harsh Vardhan Bhanot</b> is a researcher building AI systems for <em>scientific computing</em>.
          </h1>

          <p class="hero__sub reveal reveal-3">
            Fine-tuned coding models for population-genetics simulators,
            local multi-agent CTF solvers, and the reproducible infrastructure
            in-between. Currently affiliated with <a href="https://www.tamucc.edu/">TAMU&ndash;Corpus Christi</a>; incoming MS at <a href="https://www.ttu.edu/">Texas Tech</a>, fall 2026.
          </p>

          <div class="hero__ctas reveal reveal-4">
            <a class="btn btn--primary" href="#work">
              Read the work
              <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
            <a class="btn btn--ghost" href="/thoughts">
              Journal
            </a>
          </div>
        </div>

        <aside class="hero__meta reveal reveal-5" aria-label="Practice details">
          <div class="hero__meta__row">
            <span class="hero__meta__label">Practice</span>
            <span class="hero__meta__value">ML systems &amp; scientific computing</span>
          </div>
          <div class="hero__meta__row">
            <span class="hero__meta__label">Now</span>
            <span class="hero__meta__value">SLiM / Eidos fine-tuning</span>
          </div>
          <div class="hero__meta__row">
            <span class="hero__meta__label">Next</span>
            <span class="hero__meta__value">M.S. CS &middot; Texas Tech &middot; &rsquo;26</span>
          </div>
          <div class="hero__meta__row">
            <span class="hero__meta__label">Located</span>
            <span class="hero__meta__value">Corpus Christi, TX</span>
          </div>
        </aside>
      </div>
    </div>

    <canvas id="portfolio-scene" class="hero__scene" aria-hidden="true"></canvas>
  </section>

  <!-- ────────── ABOUT ────────── -->
  <section id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-grid__label" data-num="01">About</div>
        <div class="about-grid__body">
          <p>
            I am finishing a B.S. in Computer Science with an Applied
            Mathematics minor at <b>Texas A&amp;M University&ndash;Corpus
            Christi</b>, where I founded <b>Islanders Research in AI</b> and
            serve as an <b>Intel Student Brand Ambassador</b>. My work sits
            across machine learning, cybersecurity, and the infrastructure
            that makes experiments reproducible.
          </p>
          <p>
            Recently that has meant fine-tuning open-weight coding models on
            Eidos for the <a href="https://messerlab.org/slim/">SLiM</a>
            evolutionary simulator, building a local Ollama-only CTF agent,
            and shipping every training run alongside a small FastAPI runner
            so the artifact is usable on someone else&rsquo;s box.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ────────── WHAT I WORK ON ────────── -->
  <section id="focus">
    <div class="container">
      <div class="sec-head">
        <span class="sec-head__label" data-num="02">What I work on</span>
        <div class="sec-head__main">
          <h2>Three lines of work, all <em>research-grade</em>.</h2>
          <p>
            Each line of work has its own pipeline, its own evaluation, and a
            published artifact that someone outside my lab can pick up and
            run. The shared concern is reproducibility &mdash; the model is
            never the deliverable.
          </p>
        </div>
      </div>

      <div class="pillars">
        <div class="pillar">
          <span class="pillar__num">01</span>
          <h3>ML systems for science</h3>
          <p>
            Fine-tuning open-weight coding models for domain-specific
            languages &mdash; Eidos for SLiM today, scientific Python next.
            Tokenizer-aware loading, two-pass repair, evaluations that write
            to disk.
          </p>
        </div>
        <div class="pillar">
          <span class="pillar__num">02</span>
          <h3>Local AI tooling</h3>
          <p>
            Multi-agent systems &mdash; planners, specialists, verifiers
            &mdash; that run entirely on local inference. Ollama, llama.cpp,
            and Jetson Orin deployments where bandwidth and privacy matter.
          </p>
        </div>
        <div class="pillar">
          <span class="pillar__num">03</span>
          <h3>Reproducible infrastructure</h3>
          <p>
            Every training run ships with a FastAPI runner, a versioned
            adapter, and a small evaluation harness. Same repository on the
            cluster, the edge box, and the laptop.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ────────── SYSTEMS / SELECTED WORK ────────── -->
  <section id="work">
    <div class="container">
      <div class="sec-head">
        <span class="sec-head__label" data-num="03">Selected systems</span>
        <div class="sec-head__main">
          <h2>Six systems, <em>shipped</em>.</h2>
          <p>
            A representative sample &mdash; research pipelines, local AI
            tooling, and the occasional end-to-end web platform. Each links to
            the repository or the published weights.
          </p>
        </div>
      </div>

      <div class="systems">
        <a class="system" href="https://huggingface.co/hvbhanot" target="_blank" rel="noopener">
          <span class="system__num">01.</span>
          <span class="system__title">SLiM fine-tuning pipeline</span>
          <span class="system__desc">Benchmarking and fine-tuning workflow for LLM-generated SLiM/Eidos code on H100 with two-pass repair and a published LoRA adapter.</span>
          <span class="system__meta">Python · Unsloth<br />TRL · Qwen2.5-Coder</span>
          <span class="system__arrow" aria-hidden="true">→</span>
        </a>

        <a class="system" href="https://github.com/hvbhanot" target="_blank" rel="noopener">
          <span class="system__num">02.</span>
          <span class="system__title">Professor Tux</span>
          <span class="system__desc">Local AI cybersecurity teaching assistant with ChromaDB RAG, markdown teaching modes, and Jetson Orin Nano deployment.</span>
          <span class="system__meta">FastAPI · ChromaDB<br />Ollama · Jetson</span>
          <span class="system__arrow" aria-hidden="true">→</span>
        </a>

        <a class="system" href="https://github.com/hvbhanot" target="_blank" rel="noopener">
          <span class="system__num">03.</span>
          <span class="system__title">ctf_agent</span>
          <span class="system__desc">Multi-agent CTF solver &mdash; planner, specialists, verifier, 22 tool wrappers, scratchpad memory, JSON persistence.</span>
          <span class="system__meta">Python · React agents<br />Local inference</span>
          <span class="system__arrow" aria-hidden="true">→</span>
        </a>

        <a class="system" href="https://aisenate.pro" target="_blank" rel="noopener">
          <span class="system__num">04.</span>
          <span class="system__title">AI Senate</span>
          <span class="system__desc">Multi-model debate platform where frontier models argue, critique, and converge on a synthesized answer with client-side persistence.</span>
          <span class="system__meta">FastAPI · React<br />Railway</span>
          <span class="system__arrow" aria-hidden="true">→</span>
        </a>

        <a class="system" href="https://github.com/hvbhanot/FNN" target="_blank" rel="noopener">
          <span class="system__num">05.</span>
          <span class="system__title">Neural network, from scratch</span>
          <span class="system__desc">Pure NumPy feedforward network with hand-derived backprop, ReLU, softmax output, and 90%+ Iris accuracy.</span>
          <span class="system__meta">NumPy · Backprop<br />Math</span>
          <span class="system__arrow" aria-hidden="true">→</span>
        </a>

        <a class="system" href="https://github.com/hvbhanot/RestAPI" target="_blank" rel="noopener">
          <span class="system__num">06.</span>
          <span class="system__title">Go REST API &amp; JWT</span>
          <span class="system__desc">JWT-authenticated CRUD API with SQLite, clean middleware, and a practical dive into Go backend structure.</span>
          <span class="system__meta">Go · Gin<br />JWT · SQLite</span>
          <span class="system__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ────────── STATEMENT / PULLQUOTE ────────── -->
  <section class="statement">
    <div class="container">
      <div class="statement__inner">
        <blockquote>
          The real portfolio is the pipeline. <em>Reproducibility</em> is the product &mdash; the model is just the output.
        </blockquote>
        <cite><b>Harsh Vardhan Bhanot</b> &middot; working principle</cite>
      </div>
    </div>
  </section>

  <!-- ────────── TRAJECTORY ────────── -->
  <section id="experience">
    <div class="container">
      <div class="sec-head">
        <span class="sec-head__label" data-num="04">Trajectory</span>
        <div class="sec-head__main">
          <h2>Posts held, posts <em>incoming</em>.</h2>
          <p>
            Research appointments, the organisation I founded, degrees earned
            and in progress, and what is on the calendar.
          </p>
        </div>
      </div>

      <table class="ledger">
        <tbody>
          <tr>
            <td>2025 — present</td>
            <td>
              <b>Undergraduate researcher</b>
              <span>TAMU–Corpus Christi</span>
            </td>
            <td>Computational genetics &amp; AI systems &mdash; building agent workflows, SLiM analysis pipelines, and LoRA fine-tuning runs.</td>
          </tr>
          <tr>
            <td>May — Aug 2024</td>
            <td>
              <b>AI &amp; ML intern</b>
              <span>DataEssenceAI, Houston</span>
            </td>
            <td>Built PyTorch &amp; OpenCV models for predictive analysis; responsible for tuning, testing, and deployment workflows.</td>
          </tr>
          <tr>
            <td>2023 — present</td>
            <td>
              <b>Founder &amp; Vice President</b>
              <span>Islanders Research in AI</span>
            </td>
            <td>A student research organisation for ML fundamentals, reproducibility, project mentoring, and career development.</td>
          </tr>
          <tr>
            <td>2022 — 2026</td>
            <td>
              <b>B.S. Computer Science</b>
              <span>TAMU–Corpus Christi</span>
            </td>
            <td>Cybersecurity specialisation, Applied Mathematics minor, Dean&rsquo;s List standing.</td>
          </tr>
          <tr>
            <td>Fall 2026</td>
            <td>
              <b>M.S. Computer Science</b>
              <span>Texas Tech University &middot; incoming</span>
            </td>
            <td>Focused on ML systems &amp; applied AI for scientific computing.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ────────── TOOLS ────────── -->
  <section id="tools">
    <div class="container">
      <div class="sec-head">
        <span class="sec-head__label" data-num="05">Tools in rotation</span>
        <div class="sec-head__main">
          <h2>The toolkit &mdash; <em>grouped</em>.</h2>
          <p>
            Chosen so the same repository runs on an H100 cluster, a Jetson
            Orin, and my laptop without rewriting the training loop.
          </p>
        </div>
      </div>

      <div class="tools-grid">
        <div class="tools-col">
          <h4 data-num="A">Languages</h4>
          <ul>
            <li>Python <small>primary</small></li>
            <li>Go <small>backend</small></li>
            <li>C++ <small>perf</small></li>
            <li>TypeScript <small>web</small></li>
            <li>LaTeX <small>papers</small></li>
          </ul>
        </div>
        <div class="tools-col">
          <h4 data-num="B">ML &amp; research</h4>
          <ul>
            <li>PyTorch</li>
            <li>Transformers</li>
            <li>PEFT / LoRA</li>
            <li>Unsloth</li>
            <li>TRL</li>
            <li>OpenCV</li>
            <li>SLiM / Eidos</li>
          </ul>
        </div>
        <div class="tools-col">
          <h4 data-num="C">Infrastructure</h4>
          <ul>
            <li>FastAPI</li>
            <li>Docker</li>
            <li>Ollama</li>
            <li>llama.cpp</li>
            <li>Jetson Orin</li>
            <li>Linux</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ────────── CONTACT ────────── -->
  <section id="contact">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-grid__label" data-num="06">Contact</div>
        <div class="contact-grid__body">
          <h2>Open a <em>channel</em>.</h2>
          <p>
            Collaborations, research invitations, or a quick technical
            question &mdash; the fastest route is email. I read everything,
            and I reply to most.
          </p>

          <div class="channels">
            <a class="channel" href="mailto:hvbhanot1@gmail.com">
              <span class="channel__label">Email</span>
              <span class="channel__value">hvbhanot1@gmail.com</span>
              <span class="channel__arrow" aria-hidden="true">→</span>
            </a>
            <a class="channel" href="https://linkedin.com/in/hvbhanot" target="_blank" rel="noopener">
              <span class="channel__label">LinkedIn</span>
              <span class="channel__value">/in/hvbhanot</span>
              <span class="channel__arrow" aria-hidden="true">→</span>
            </a>
            <a class="channel" href="https://github.com/hvbhanot" target="_blank" rel="noopener">
              <span class="channel__label">GitHub</span>
              <span class="channel__value">@hvbhanot</span>
              <span class="channel__arrow" aria-hidden="true">→</span>
            </a>
            <a class="channel" href="https://huggingface.co/hvbhanot" target="_blank" rel="noopener">
              <span class="channel__label">Hugging Face</span>
              <span class="channel__value">@hvbhanot</span>
              <span class="channel__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import * as THREE from 'three';

    const canvas = document.querySelector('#portfolio-scene');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (canvas instanceof HTMLCanvasElement) {
      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        preserveDrawingBuffer: true,
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
      camera.position.set(0, 0, 5.6);

      // Restrained: a slowly rotating wireframe sphere — institutional, quiet
      const ink = new THREE.Color('#a9b1c1');
      const accent = new THREE.Color('#c8a96a');

      const sphere = new THREE.LineSegments(
        new THREE.EdgesGeometry(new THREE.IcosahedronGeometry(1.6, 2)),
        new THREE.LineBasicMaterial({ color: ink, transparent: true, opacity: 0.45 }),
      );
      scene.add(sphere);

      const inner = new THREE.Mesh(
        new THREE.IcosahedronGeometry(0.9, 1),
        new THREE.MeshBasicMaterial({ color: accent, wireframe: true, transparent: true, opacity: 0.5 }),
      );
      scene.add(inner);

      const dotGeo = new THREE.BufferGeometry();
      const dotCount = 60;
      const positions = new Float32Array(dotCount * 3);
      for (let i = 0; i < dotCount; i += 1) {
        const r = 2.6 + Math.random() * 1.2;
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(2 * Math.random() - 1);
        positions[i * 3]     = r * Math.sin(phi) * Math.cos(theta);
        positions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta) * 0.6;
        positions[i * 3 + 2] = r * Math.cos(phi);
      }
      dotGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      const dots = new THREE.Points(
        dotGeo,
        new THREE.PointsMaterial({ size: 0.025, color: ink, transparent: true, opacity: 0.45 }),
      );
      scene.add(dots);

      const resize = () => {
        const { clientWidth, clientHeight } = canvas;
        renderer.setSize(clientWidth, clientHeight, false);
        camera.aspect = clientWidth / Math.max(clientHeight, 1);
        camera.updateProjectionMatrix();
      };
      const ro = new ResizeObserver(resize);
      ro.observe(canvas);
      resize();

      const clock = new THREE.Clock();
      const render = () => {
        const t = clock.getElapsedTime();
        const speed = reducedMotion ? 0.1 : 1;

        sphere.rotation.y = t * 0.1 * speed;
        sphere.rotation.x = Math.sin(t * 0.07 * speed) * 0.18;
        inner.rotation.y = -t * 0.18 * speed;
        inner.rotation.x = t * 0.13 * speed;
        dots.rotation.y = t * 0.04 * speed;

        renderer.render(scene, camera);
        window.requestAnimationFrame(render);
      };
      render();
    }
  </script>
</Base>
