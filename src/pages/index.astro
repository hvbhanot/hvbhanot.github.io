  <script>
    import * as THREE from 'three';

    const canvas = document.querySelector('#portfolio-scene');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (canvas instanceof HTMLCanvasElement) {
      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        preserveDrawingBuffer: true,
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
      camera.position.set(0, 0, 11);

      const group = new THREE.Group();
      scene.add(group);

      // Ink colors (matching editorial palette)
      const INK = new THREE.Color('#1a1812');
      const STAMP = new THREE.Color('#c83c1c');
      const OXIDE = new THREE.Color('#1e3a52');

      // DNA double helix — two sinusoidal strands with rungs
      const turns = 2.6;
      const segments = 120;
      const radius = 1.25;
      const height = 7.4;

      const strandA = [];
      const strandB = [];
      for (let i = 0; i <= segments; i += 1) {
        const t = i / segments;
        const y = (t - 0.5) * height;
        const angle = t * Math.PI * 2 * turns;
        strandA.push(new THREE.Vector3(Math.cos(angle) * radius, y, Math.sin(angle) * radius));
        strandB.push(new THREE.Vector3(Math.cos(angle + Math.PI) * radius, y, Math.sin(angle + Math.PI) * radius));
      }

      const lineMat = new THREE.LineBasicMaterial({ color: INK, transparent: true, opacity: 0.85, linewidth: 1 });
      const lineMat2 = new THREE.LineBasicMaterial({ color: OXIDE, transparent: true, opacity: 0.7, linewidth: 1 });

      group.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(strandA), lineMat));
      group.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(strandB), lineMat2));

      // Base pairs (rungs) — every 6 segments
      const rungMat = new THREE.LineBasicMaterial({ color: INK, transparent: true, opacity: 0.22 });
      const rungStampMat = new THREE.LineBasicMaterial({ color: STAMP, transparent: true, opacity: 0.9 });
      for (let i = 0; i <= segments; i += 6) {
        const isStamp = i % 18 === 0;
        const mat = isStamp ? rungStampMat : rungMat;
        const geo = new THREE.BufferGeometry().setFromPoints([strandA[i], strandB[i]]);
        group.add(new THREE.Line(geo, mat));
      }

      // Nucleotide points
      const sphereGeo = new THREE.SphereGeometry(0.05, 12, 12);
      const nodeMatInk = new THREE.MeshBasicMaterial({ color: INK });
      const nodeMatStamp = new THREE.MeshBasicMaterial({ color: STAMP });
      const nodeMatOxide = new THREE.MeshBasicMaterial({ color: OXIDE });
      for (let i = 0; i <= segments; i += 3) {
        const sA = new THREE.Mesh(sphereGeo, i % 9 === 0 ? nodeMatStamp : nodeMatInk);
        sA.position.copy(strandA[i]);
        const sB = new THREE.Mesh(sphereGeo, i % 9 === 0 ? nodeMatStamp : nodeMatOxide);
        sB.position.copy(strandB[i]);
        group.add(sA, sB);
      }

      // Subtle perimeter arc (like an engraved bracket)
      const arcPts = [];
      for (let i = 0; i <= 64; i += 1) {
        const t = i / 64;
        const a = (t - 0.5) * Math.PI * 0.9;
        arcPts.push(new THREE.Vector3(Math.sin(a) * 3.6 + 2.8, Math.cos(a) * 3.6 - 0.2, 0));
      }
      const arc = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(arcPts),
        new THREE.LineBasicMaterial({ color: INK, transparent: true, opacity: 0.08 }),
      );
      group.add(arc);

      // Tilt for frontispiece feel
      group.rotation.x = 0.22;
      group.rotation.z = 0.08;

      const pointer = { x: 0, y: 0 };
      window.addEventListener('pointermove', (event) => {
        pointer.x = (event.clientX / window.innerWidth - 0.5) * 2;
        pointer.y = (event.clientY / window.innerHeight - 0.5) * 2;
      });

      const resize = () => {
        const { clientWidth, clientHeight } = canvas;
        renderer.setSize(clientWidth, clientHeight, false);
        camera.aspect = clientWidth / Math.max(clientHeight, 1);
        camera.updateProjectionMatrix();
      };
      const ro = new ResizeObserver(resize);
      ro.observe(canvas);
      resize();

      const clock = new THREE.Clock();
      const render = () => {
        const t = clock.getElapsedTime();
        const speed = reducedMotion ? 0.1 : 1;

        group.rotation.y = t * 0.25 * speed + pointer.x * 0.25;
        group.rotation.x = 0.22 + Math.sin(t * 0.3 * speed) * 0.05 + pointer.y * 0.08;

        renderer.render(scene, camera);
        window.requestAnimationFrame(render);
      };
      render();
    }
  </script>
</Base>
