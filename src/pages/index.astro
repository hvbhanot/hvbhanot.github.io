              <dd class="hero__metric__value">612</dd>
            </div>
            <div class="hero__metric">
              <dt class="hero__metric__label">Adapters</dt>
              <dd class="hero__metric__value">7</dd>
            </div>
            <div class="hero__metric">
              <dt class="hero__metric__label">Pass@1</dt>
              <dd class="hero__metric__value">0.71</dd>
