---
import Base from '../layouts/Base.astro';
---

<Base>
  <section class="portfolio-hero" aria-labelledby="hero-title">
    <canvas id="portfolio-scene" class="portfolio-hero__scene" aria-hidden="true"></canvas>
    <div class="portfolio-hero__shade" aria-hidden="true"></div>

    <div class="container portfolio-hero__inner">
      <div class="portfolio-hero__copy">
        <p class="kicker reveal reveal-1">CS @ TAMU-CC / AI systems / applied math</p>
        <h1 id="hero-title" class="portfolio-hero__title reveal reveal-2">
          Harsh Vardhan Bhanot builds AI research systems.
        </h1>
        <p class="portfolio-hero__lede reveal reveal-3">
          I fine-tune coding models for population-genetics simulators, build
          local multi-agent CTF solvers, and turn research ideas into reproducible
          infrastructure.
        </p>
        <div class="hero-actions reveal reveal-4">
          <a class="button button--primary" href="#work">View work</a>
          <a class="button button--ghost" href="mailto:hvbhanot1@gmail.com">Contact</a>
        </div>
      </div>

      <aside class="command-panel reveal reveal-5" aria-label="Portfolio status">
        <div class="command-panel__top">
          <span>live map</span>
          <span class="status-dot">online</span>
        </div>
        <dl class="signal-list">
          <div>
            <dt>Focus</dt>
            <dd>ML systems + scientific computing</dd>
          </div>
          <div>
            <dt>Now</dt>
            <dd>SLiM/Eidos fine-tuning and evaluation</dd>
          </div>
          <div>
            <dt>Next</dt>
            <dd>MS CS @ Texas Tech, fall 2026</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section data-counted id="work" class="work-stage">
    <div class="container">
      <div class="section-head">
        <p class="section-label">Selected Work</p>
        <h2 class="section-title">Project nodes worth opening.</h2>
      </div>

      <div class="project-orbit" aria-label="Selected projects">
        <a class="project-card project-card--large" href="https://huggingface.co/hvbhanot" target="_blank" rel="noopener">
          <span class="project-card__index">01</span>
          <h3>SLiM Fine-Tuning Pipeline</h3>
          <p>
            Benchmarking and fine-tuning workflow for LLM-generated SLiM/Eidos
            code on H100, with tokenizer-aware loading, two-pass repair, Excel
            output, and a published LoRA adapter.
          </p>
          <span class="project-card__meta">python / unsloth / trl / qwen2.5-coder</span>
        </a>

        <a class="project-card" href="https://github.com/hvbhanot" target="_blank" rel="noopener">
          <span class="project-card__index">02</span>
          <h3>Professor Tux</h3>
          <p>
            Local AI cybersecurity teaching assistant with FastAPI, ChromaDB RAG,
            markdown teaching modes, Ollama, and Jetson Orin Nano deployment.
          </p>
          <span class="project-card__meta">fastapi / chromadb / ollama</span>
        </a>

        <a class="project-card" href="https://github.com/hvbhanot" target="_blank" rel="noopener">
          <span class="project-card__index">03</span>
          <h3>ctf_agent</h3>
          <p>
            Multi-agent CTF solver with planner, specialists, verifier, 22 tool
            wrappers, scratchpad memory, JSON persistence, and local inference.
          </p>
          <span class="project-card__meta">python / react agents / ctf</span>
        </a>

        <a class="project-card" href="https://aisenate.pro" target="_blank" rel="noopener">
          <span class="project-card__index">04</span>
          <h3>AI Senate</h3>
          <p>
            Multi-model debate platform where frontier models argue, critique,
            and converge on a synthesized answer with client-side persistence.
          </p>
          <span class="project-card__meta">fastapi / react / railway</span>
        </a>

        <a class="project-card" href="https://github.com/hvbhanot/FNN" target="_blank" rel="noopener">
          <span class="project-card__index">05</span>
          <h3>Neural Net from Scratch</h3>
          <p>
            Pure NumPy feedforward network with hand-derived backprop, ReLU,
            softmax output, and 90%+ Iris accuracy.
          </p>
          <span class="project-card__meta">numpy / backprop / math</span>
        </a>

        <a class="project-card" href="https://github.com/hvbhanot/RestAPI" target="_blank" rel="noopener">
          <span class="project-card__index">06</span>
          <h3>Go REST API + JWT</h3>
          <p>
            JWT-authenticated CRUD API with SQLite, clean middleware, and a
            practical dive into Go backend structure.
          </p>
          <span class="project-card__meta">go / gin / jwt / sqlite</span>
        </a>
      </div>
    </div>
  </section>

  <section data-counted id="about" class="depth-section">
    <div class="container depth-grid">
      <div>
        <p class="section-label">About</p>
        <h2 class="section-title">Builder first. Researcher by training.</h2>
      </div>
      <div class="copy-stack">
        <p>
          I am finishing a BS in Computer Science with an Applied Math minor at
          Texas A&amp;M University-Corpus Christi, where I founded Islanders
          Research in AI and serve as an Intel Student Brand Ambassador.
        </p>
        <p>
          My work sits across machine learning, cybersecurity, and the
          infrastructure that makes experiments reproducible. Recently that has
          meant fine-tuning open-weight coding models on Eidos for the
          <a href="https://messerlab.org/slim/">SLiM</a> evolutionary simulator
          and building a local Ollama-only CTF agent.
        </p>
      </div>
    </div>
  </section>

  <section data-counted id="experience" class="timeline-section">
    <div class="container">
      <div class="section-head">
        <p class="section-label">Trajectory</p>
        <h2 class="section-title">The current path through the system.</h2>
      </div>

      <ol class="timeline">
        <li>
          <time>2025 - present</time>
          <div>
            <h3>Undergraduate Researcher</h3>
            <p>Computational genetics and AI systems at TAMU-CC, building agent workflows, SLiM analysis pipelines, and LoRA fine-tuning runs.</p>
          </div>
        </li>
        <li>
          <time>May - Aug 2024</time>
          <div>
            <h3>AI &amp; ML Intern</h3>
            <p>DataEssenceAI, Houston. Built PyTorch and OpenCV models for predictive analysis, tuning, testing, and deployment workflows.</p>
          </div>
        </li>
        <li>
          <time>2023 - present</time>
          <div>
            <h3>Founder &amp; Vice President</h3>
            <p>Islanders Research in AI, a student research org for ML fundamentals, reproducibility, project mentoring, and career development.</p>
          </div>
        </li>
        <li>
          <time>2022 - 2026</time>
          <div>
            <h3>B.S. Computer Science</h3>
            <p>Texas A&amp;M University-Corpus Christi, cybersecurity specialization, applied math minor, Dean's List standing.</p>
          </div>
        </li>
        <li>
          <time>Fall 2026</time>
          <div>
            <h3>M.S. Computer Science</h3>
            <p>Incoming at Texas Tech University, focused on ML systems and applied AI for scientific computing.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section data-counted id="stack" class="stack-section">
    <div class="container stack-layout">
      <div>
        <p class="section-label">Stack</p>
        <h2 class="section-title">Tools in active rotation.</h2>
      </div>
      <div class="stack-cloud" aria-label="Skills">
        <span>Python</span><span>Go</span><span>C++</span><span>TypeScript</span>
        <span>PyTorch</span><span>Transformers</span><span>PEFT / LoRA</span>
        <span>Unsloth</span><span>FastAPI</span><span>Docker</span>
        <span>Ollama</span><span>Jetson</span><span>SLiM / Eidos</span>
        <span>Linux</span><span>OpenCV</span><span>LaTeX</span>
      </div>
    </div>
  </section>

  <section data-counted id="contact" class="contact-section">
    <div class="container contact-grid">
      <div>
        <p class="section-label">Contact</p>
        <h2 class="section-title">Open a channel.</h2>
      </div>
      <div class="contact-links">
        <a href="mailto:hvbhanot1@gmail.com"><span>Email</span><strong>hvbhanot1@gmail.com</strong></a>
        <a href="https://linkedin.com/in/hvbhanot" target="_blank" rel="noopener"><span>LinkedIn</span><strong>/in/hvbhanot</strong></a>
        <a href="https://github.com/hvbhanot" target="_blank" rel="noopener"><span>GitHub</span><strong>@hvbhanot</strong></a>
        <a href="https://huggingface.co/hvbhanot" target="_blank" rel="noopener"><span>Hugging Face</span><strong>@hvbhanot</strong></a>
      </div>
    </div>
  </section>

  <script>
    import * as THREE from 'three';

    const canvas = document.querySelector('#portfolio-scene');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (canvas instanceof HTMLCanvasElement) {
      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        preserveDrawingBuffer: true,
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
      camera.position.set(0, 0.9, 8);

      const group = new THREE.Group();
      scene.add(group);

      const palette = {
        cyan: new THREE.Color('#4fd8ff'),
        amber: new THREE.Color('#f4b860'),
        rose: new THREE.Color('#ff6f91'),
        green: new THREE.Color('#7be495'),
      };

      const coreMaterial = new THREE.MeshStandardMaterial({
        color: palette.cyan,
        metalness: 0.72,
        roughness: 0.22,
        emissive: '#173f4d',
        emissiveIntensity: 0.35,
      });
      const wireMaterial = new THREE.MeshBasicMaterial({
        color: palette.amber,
        wireframe: true,
        transparent: true,
        opacity: 0.32,
      });

      const core = new THREE.Mesh(new THREE.IcosahedronGeometry(1.45, 3), coreMaterial);
      const wire = new THREE.Mesh(new THREE.TorusKnotGeometry(2.25, 0.045, 220, 12, 2, 5), wireMaterial);
      group.add(core, wire);

      const ringMaterial = new THREE.MeshBasicMaterial({
        color: palette.rose,
        transparent: true,
        opacity: 0.48,
        side: THREE.DoubleSide,
      });
      for (let i = 0; i < 3; i += 1) {
        const ring = new THREE.Mesh(new THREE.TorusGeometry(3 + i * 0.48, 0.012, 8, 160), ringMaterial);
        ring.rotation.x = Math.PI / 2 + i * 0.36;
        ring.rotation.y = i * 0.5;
        group.add(ring);
      }

      const pointsGeometry = new THREE.BufferGeometry();
      const pointCount = 900;
      const positions = new Float32Array(pointCount * 3);
      const colors = new Float32Array(pointCount * 3);
      for (let i = 0; i < pointCount; i += 1) {
        const radius = 4.2 + Math.random() * 6.5;
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(2 * Math.random() - 1);
        positions[i * 3] = radius * Math.sin(phi) * Math.cos(theta);
        positions[i * 3 + 1] = radius * Math.sin(phi) * Math.sin(theta) * 0.62;
        positions[i * 3 + 2] = radius * Math.cos(phi);

        const color = [palette.cyan, palette.amber, palette.rose, palette.green][i % 4];
        colors[i * 3] = color.r;
        colors[i * 3 + 1] = color.g;
        colors[i * 3 + 2] = color.b;
      }
      pointsGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      pointsGeometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
      const points = new THREE.Points(
        pointsGeometry,
        new THREE.PointsMaterial({
          size: 0.035,
          vertexColors: true,
          transparent: true,
          opacity: 0.82,
          depthWrite: false,
        }),
      );
      scene.add(points);

      const grid = new THREE.GridHelper(18, 36, '#4fd8ff', '#243548');
      grid.position.y = -2.15;
      grid.material.transparent = true;
      grid.material.opacity = 0.18;
      scene.add(grid);

      scene.add(new THREE.AmbientLight('#d8f6ff', 0.85));
      const key = new THREE.PointLight('#4fd8ff', 12, 18);
      key.position.set(2.6, 3.4, 4);
      scene.add(key);
      const fill = new THREE.PointLight('#ff6f91', 6, 18);
      fill.position.set(-3, -1, 3);
      scene.add(fill);

      const pointer = { x: 0, y: 0 };
      window.addEventListener('pointermove', (event) => {
        pointer.x = (event.clientX / window.innerWidth - 0.5) * 2;
        pointer.y = (event.clientY / window.innerHeight - 0.5) * 2;
      });

      const resize = () => {
        const { clientWidth, clientHeight } = canvas;
        renderer.setSize(clientWidth, clientHeight, false);
        camera.aspect = clientWidth / Math.max(clientHeight, 1);
        camera.updateProjectionMatrix();
      };
      window.addEventListener('resize', resize);
      resize();

      const clock = new THREE.Clock();
      const render = () => {
        const time = clock.getElapsedTime();
        const speed = reducedMotion ? 0.08 : 1;

        group.rotation.y = time * 0.16 * speed + pointer.x * 0.22;
        group.rotation.x = -0.18 + pointer.y * 0.12;
        wire.rotation.z = time * 0.11 * speed;
        points.rotation.y = time * 0.025 * speed;
        grid.position.z = ((time * 0.45 * speed) % 1) - 0.5;

        renderer.render(scene, camera);
        window.requestAnimationFrame(render);
      };
      render();
    }
  </script>
</Base>
