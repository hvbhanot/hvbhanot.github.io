---
import Base from '../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('thoughts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'thoughts'> };
const { post } = Astro.props;
const { Content } = await post.render();

const fmt = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${post.data.title} — Harsh Vardhan Bhanot`} description={post.data.description} current="thoughts">
  <article style="padding-block: clamp(4rem, 8vw, 6rem) 5rem;">
    <div class="container--reading">
      <header style="margin-bottom: 3rem; text-align: center; padding-bottom: 2rem; border-bottom: 1px solid var(--rule);">
        <p class="smallcaps" style="margin-bottom: 1.1rem; color: var(--stamp);">
          Journal entry &nbsp; · &nbsp; {fmt}
          {post.data.tags.length > 0 && <span style="color: var(--ink-3);"> · {post.data.tags.join(' · ')}</span>}
        </p>
        <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 4.5vw + 0.5rem, 3.6rem); line-height: 1.05; letter-spacing: -0.035em; max-width: 22ch; margin: 0 auto 1rem; font-weight: 380; font-variation-settings: 'opsz' 144, 'SOFT' 30;">
          {post.data.title}
        </h1>
        {
          post.data.description && (
            <p style="font-family: var(--font-display); font-size: 1.15rem; color: var(--ink-2); max-width: 58ch; line-height: 1.5; margin: 0 auto; font-style: italic; font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 48;">
              {post.data.description}
            </p>
          )
        }
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer style="margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); text-align: center;">
        <a href="/thoughts" class="smallcaps" style="color: var(--stamp); transition: color 180ms ease;">
          ← back to the journal
        </a>
      </footer>
    </div>
  </article>
</Base>
