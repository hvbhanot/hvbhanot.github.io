---
import Base from '../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('thoughts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'thoughts'> };
const { post } = Astro.props;
const { Content } = await post.render();

const fmt = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${post.data.title} — Harsh Vardhan Bhanot`} description={post.data.description} current="thoughts">
  <article style="padding-block: clamp(4rem, 8vw, 6rem) 5rem;">
    <div class="container--narrow">
      <header style="margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border);">
        <span class="sec-tag" style="margin-bottom: 1.25rem;">journal entry · {fmt}</span>
        {post.data.tags.length > 0 && (
          <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 1rem 0;">
            {post.data.tags.map((t) => <span class="chip">{t}</span>)}
          </div>
        )}
        <h1 style="font-size: clamp(2rem, 4.5vw + 0.5rem, 3.6rem); line-height: 1.03; letter-spacing: -0.04em; max-width: 22ch; margin: 1.25rem 0 1rem; font-weight: 500; color: var(--ink);">
          {post.data.title}
        </h1>
        {
          post.data.description && (
            <p style="font-size: 1.1rem; color: var(--ink-2); max-width: 58ch; line-height: 1.55;">
              {post.data.description}
            </p>
          )
        }
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer style="margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
        <a href="/thoughts" class="mono" style="font-size: 0.85rem; color: var(--violet-2); transition: color 180ms ease;">
          ← back to the journal
        </a>
      </footer>
    </div>
  </article>
</Base>
