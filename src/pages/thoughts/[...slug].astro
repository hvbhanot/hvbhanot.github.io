---
import Base from '../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('thoughts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'thoughts'> };
const { post } = Astro.props;
const { Content } = await post.render();

const fmt = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${post.data.title} — Harsh Vardhan Bhanot`} description={post.data.description} current="thoughts">
  <article style="padding-block: clamp(4rem, 9vw, 7rem) 5rem; border-top: 0;">
    <div class="container--narrow">
      <header style="margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--rule);">
        <p class="eyebrow eyebrow--accent" style="margin-bottom: 1.5rem;">
          — Journal entry &middot; {fmt}
          {post.data.tags.length > 0 && (<span style="color: var(--ink-3);"> &middot; {post.data.tags.join(' · ')}</span>)}
        </p>
        <h1 style="font-size: clamp(2rem, 4vw + 0.5rem, 3.4rem); line-height: 1.08; letter-spacing: -0.025em; font-weight: 300; max-width: 22ch; color: var(--ink); margin-bottom: 1.25rem;">
          {post.data.title}
        </h1>
        {
          post.data.description && (
            <p style="font-size: 1.12rem; color: var(--ink-2); max-width: 58ch; line-height: 1.55;">
              {post.data.description}
            </p>
          )
        }
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer style="margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--rule);">
        <a href="/thoughts" class="mono" style="font-size: 0.84rem; color: var(--accent); transition: color 180ms ease;">
          ← back to journal
        </a>
      </footer>
    </div>
  </article>
</Base>
