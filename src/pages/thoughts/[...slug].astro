---
import Base from '../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('thoughts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'thoughts'> };
const { post } = Astro.props;
const { Content } = await post.render();

const fmt = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${post.data.title} — Harsh Vardhan Bhanot`} description={post.data.description} current="thoughts">
  <article style="padding-block: clamp(5rem, 10vw, 8rem) 6rem;">
    <div class="container container--narrow">
      <header style="margin-bottom: 3rem;">
        <p class="eyebrow" style="margin-bottom: 1.25rem;">
          {fmt}
          {post.data.tags.length > 0 && <span> &middot; {post.data.tags.join(' · ')}</span>}
        </p>
        <h1 style="font-size: clamp(2rem, 4.5vw + 0.5rem, 3.4rem); letter-spacing: -0.035em; line-height: 1.05; max-width: 22ch; margin-bottom: 1rem;">
          {post.data.title}
        </h1>
        {
          post.data.description && (
            <p style="font-size: 1.05rem; color: var(--ink-3); max-width: 58ch; line-height: 1.55;">
              {post.data.description}
            </p>
          )
        }
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer style="margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
        <a href="/thoughts" class="mono" style="font-size: 0.82rem; color: var(--ink-3); transition: color 160ms ease;"
          onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--ink-3)'">
          ← back to all thoughts
        </a>
      </footer>
    </div>
  </article>
</Base>
