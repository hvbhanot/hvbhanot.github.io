---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('thoughts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).toLowerCase();
---

<Base title="Journal — Harsh Vardhan Bhanot" current="thoughts">
  <section style="padding-block: clamp(4rem, 9vw, 7rem) 1rem; border-bottom: 1px solid var(--rule);">
    <div class="container">
      <div class="sec-head">
        <span class="sec-num">Journal &nbsp; · &nbsp; notes &amp; essays</span>
        <h1 class="sec-title" style="font-size: clamp(2.4rem, 5vw + 0.5rem, 4.2rem); letter-spacing: -0.035em;">
          Working notes, <em>half-baked</em> ideas, and post-mortems.
        </h1>
        <p class="sec-lede">
          Thinking out loud about ML systems, research infrastructure, and the
          weird stuff I run into while building them.
        </p>
      </div>
    </div>
  </section>

  <section style="padding-block: 2rem 5rem;">
    <div class="container">
      {
        posts.length === 0 ? (
          <p class="mono" style="color: var(--ink-3);">
            // no entries yet — check back soon
          </p>
        ) : (
          <ol class="thoughts">
            {posts.map((post, i) => (
              <li>
                <a href={`/thoughts/${post.slug}`} class="thought-item">
                  <span class="thought-item__date">{fmt(post.data.date)}</span>
                  <h3 class="thought-item__title">{post.data.title}</h3>
                  <span class="thought-item__read">read →</span>
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</Base>
