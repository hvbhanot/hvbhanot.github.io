---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('thoughts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).toLowerCase();
---

<Base title="Thoughts — Harsh Vardhan Bhanot" current="thoughts">
  <section class="hero" style="padding-block: clamp(5rem, 10vw, 8rem) 2rem;">
    <div class="container narrow">
      <p class="hero__eyebrow">Notes & essays</p>
      <h1 class="hero__title" style="font-size: clamp(2.4rem, 5vw + 0.5rem, 4.2rem); max-width: 16ch;">
        Working notes, <em>half-baked</em><br />ideas, and post-mortems.
      </h1>
      <p class="hero__lede">
        Thinking out loud about ML systems, research infrastructure, and the
        weird stuff I run into building them.
      </p>
    </div>
  </section>

  <section style="padding-block: 2rem 6rem; border-top: none;">
    <div class="container narrow">
      {
        posts.length === 0 ? (
          <p style="font-family: var(--font-mono); font-size: 0.9rem; color: var(--ink-mute);">
            // no posts yet — check back soon
          </p>
        ) : (
          <ol class="thought-list">
            {posts.map((post) => (
              <li>
                <a href={`/thoughts/${post.slug}`} class="thought-item">
                  <span class="thought-item__date">{fmt(post.data.date)}</span>
                  <h3 class="thought-item__title">{post.data.title}</h3>
                  <span class="thought-item__read">read →</span>
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</Base>
