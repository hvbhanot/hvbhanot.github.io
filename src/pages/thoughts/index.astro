---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('thoughts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).toLowerCase();
---

<Base title="Journal — Harsh Vardhan Bhanot" current="thoughts">
  <section style="padding-block: clamp(5rem, 11vw, 9rem) 2.5rem; border-top: 0;">
    <div class="container">
      <p class="eyebrow eyebrow--accent" style="margin-bottom: 2rem;">— Journal &middot; notes &amp; essays</p>
      <h1 style="font-size: clamp(2.2rem, 4.5vw + 0.5rem, 4.2rem); line-height: 1.08; letter-spacing: -0.025em; font-weight: 300; max-width: 18ch; color: var(--ink); margin-bottom: 1.5rem;">
        Working notes, half-baked ideas, and post-mortems.
      </h1>
      <p style="color: var(--ink-2); font-size: clamp(1rem, 0.5vw + 0.9rem, 1.15rem); line-height: 1.6; max-width: 56ch;">
        Thinking out loud about ML systems, research infrastructure, and the
        weird stuff I run into while building them.
      </p>
    </div>
  </section>

  <section style="padding-block: 1.5rem 6rem;">
    <div class="container">
      {
        posts.length === 0 ? (
          <p class="mono" style="color: var(--ink-3);">
            // no entries yet — check back soon
          </p>
        ) : (
          <ol class="thoughts">
            {posts.map((post) => (
              <li>
                <a href={`/thoughts/${post.slug}`} class="thought-item">
                  <span class="thought-item__date">{fmt(post.data.date)}</span>
                  <h3 class="thought-item__title">{post.data.title}</h3>
                  <span class="thought-item__read">read →</span>
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</Base>
