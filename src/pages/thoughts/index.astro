---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('thoughts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).toLowerCase();
---

<Base title="Thoughts — Harsh Vardhan Bhanot" current="thoughts">
  <section style="padding-block: clamp(5rem, 10vw, 8rem) 2rem;">
    <div class="container container--narrow">
      <p class="eyebrow" style="margin-bottom: 1.25rem;">Notes &amp; essays</p>
      <h1 style="font-size: clamp(2.2rem, 5vw + 0.5rem, 3.8rem); letter-spacing: -0.035em; line-height: 1.02; max-width: 18ch; margin-bottom: 1rem;">
        Working notes, half-baked ideas, and post-mortems.
      </h1>
      <p style="color: var(--ink-3); font-size: 1.02rem; line-height: 1.55; max-width: 56ch;">
        Thinking out loud about ML systems, research infrastructure, and the
        weird stuff I run into building them.
      </p>
    </div>
  </section>

  <section style="padding-block: 1rem 5rem;">
    <div class="container container--narrow">
      {
        posts.length === 0 ? (
          <p class="mono" style="font-size: 0.9rem; color: var(--ink-3);">
            // no posts yet — check back soon
          </p>
        ) : (
          <ol class="thought-list">
            {posts.map((post) => (
              <li>
                <a href={`/thoughts/${post.slug}`} class="thought-item">
                  <span class="thought-item__date">{fmt(post.data.date)}</span>
                  <h3 class="thought-item__title">{post.data.title}</h3>
                  <span class="thought-item__read">read →</span>
                </a>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</Base>
