---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: 'home' | 'thoughts';
}

const {
  title = 'Harsh Vardhan Bhanot — AI Systems & Research',
  description = 'CS undergrad at TAMU–Corpus Christi. Building AI systems, evolutionary simulation tooling, and ML-powered research infrastructure.',
  current = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#efe8d9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="brand" aria-label="Home">
          <span class="brand__stamp" aria-hidden="true">HB</span>
          <span class="brand__full">Harsh Vardhan <em>Bhanot</em></span>
          <span class="brand__vol">Vol. 01</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="/#summary">Summary</a>
          <a href="/#work">Systems</a>
          <a href="/#experience">Trajectory</a>
          <a href="/#stack">Tools</a>
          <a href="/thoughts" aria-current={current === 'thoughts' ? 'page' : undefined}>Journal</a>
        </nav>
        <div class="header-cta">
          <a href="https://github.com/hvbhanot" target="_blank" rel="noopener" class="header-cta__signin">GitHub</a>
          <a href="mailto:hvbhanot1@gmail.com" class="btn btn--stamp">
            Write
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="colophon">
      <div class="container colophon__inner">
        <div class="colophon__brand">
          <a href="/" class="brand" aria-label="Home">
            <span class="brand__stamp" aria-hidden="true">HB</span>
            <span>Harsh Vardhan <em>Bhanot</em></span>
          </a>
          <p>A working journal of AI research systems, evolutionary-simulation tooling, and reproducible infrastructure — kept from Corpus Christi, Texas.</p>
        </div>
        <div class="colophon__col">
          <h5>Sections</h5>
          <ul>
            <li><a href="/#summary">§1 Summary</a></li>
            <li><a href="/#work">§2 Systems</a></li>
            <li><a href="/#experience">§3 Trajectory</a></li>
            <li><a href="/#stack">§4 Tools</a></li>
          </ul>
        </div>
        <div class="colophon__col">
          <h5>Elsewhere</h5>
          <ul>
            <li><a href="https://github.com/hvbhanot" target="_blank" rel="noopener">GitHub</a></li>
            <li><a href="https://huggingface.co/hvbhanot" target="_blank" rel="noopener">Hugging Face</a></li>
            <li><a href="https://linkedin.com/in/hvbhanot" target="_blank" rel="noopener">LinkedIn</a></li>
            <li><a href="mailto:hvbhanot1@gmail.com">Email</a></li>
          </ul>
        </div>
        <div class="colophon__col">
          <h5>Also by</h5>
          <ul>
            <li><a href="/thoughts">Journal</a></li>
            <li><a href="https://aisenate.pro" target="_blank" rel="noopener">AI Senate</a></li>
            <li><a href="https://huggingface.co/hvbhanot/slim-coder-lora" target="_blank" rel="noopener">slim-coder-lora</a></li>
          </ul>
        </div>
      </div>

      <div class="container colophon__bottom">
        <span>© {new Date().getFullYear()} Harsh Vardhan Bhanot · TAMU–Corpus Christi</span>
        <span>Set in <em>Fraunces</em>, Inter &amp; JetBrains Mono. Printed on the open web.</span>
      </div>
    </footer>
  </body>
</html>
