---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: 'home' | 'thoughts';
}

const {
  title = 'Harsh Vardhan Bhanot — AI Systems & Research',
  description = 'CS undergrad at TAMU–Corpus Christi. Building AI systems, evolutionary simulation tooling, and ML-powered research infrastructure.',
  current = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="brand" aria-label="Home">
          <span class="brand__mark" aria-hidden="true"></span>
          <span class="brand__full">hvbhanot</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="/#work" aria-current={current === 'home' ? undefined : undefined}>Work</a>
          <a href="/#experience">Trajectory</a>
          <a href="/#stack">Stack</a>
          <a href="/thoughts" aria-current={current === 'thoughts' ? 'page' : undefined}>Thoughts</a>
          <a href="/#contact">Contact</a>
        </nav>
        <div class="header-cta">
          <a href="https://github.com/hvbhanot" target="_blank" rel="noopener" class="header-cta__signin">Sign in</a>
          <a href="mailto:hvbhanot1@gmail.com" class="btn btn--primary">
            Get in touch
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div class="site-footer__brand">
          <a href="/" class="brand" aria-label="Home">
            <span class="brand__mark" aria-hidden="true"></span>
            <span>hvbhanot</span>
          </a>
          <p>Building AI research systems, fine-tuned models, and reproducible infrastructure from Corpus Christi, Texas.</p>
        </div>
        <div class="site-footer__col">
          <h5>Work</h5>
          <ul>
            <li><a href="/#work">Projects</a></li>
            <li><a href="/#experience">Trajectory</a></li>
            <li><a href="/#stack">Stack</a></li>
            <li><a href="/thoughts">Thoughts</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <h5>Elsewhere</h5>
          <ul>
            <li><a href="https://github.com/hvbhanot" target="_blank" rel="noopener">GitHub</a></li>
            <li><a href="https://huggingface.co/hvbhanot" target="_blank" rel="noopener">Hugging Face</a></li>
            <li><a href="https://linkedin.com/in/hvbhanot" target="_blank" rel="noopener">LinkedIn</a></li>
            <li><a href="mailto:hvbhanot1@gmail.com">Email</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <h5>About</h5>
          <ul>
            <li><a href="/#about">Bio</a></li>
            <li><a href="/#contact">Contact</a></li>
            <li><a href="https://aisenate.pro" target="_blank" rel="noopener">AI Senate</a></li>
          </ul>
        </div>
      </div>

      <section class="wordmark" aria-hidden="true">
        <div class="wordmark__text">hvbhanot</div>
      </section>

      <div class="container site-footer__bottom">
        <span>© {new Date().getFullYear()} Harsh Vardhan Bhanot</span>
        <span>TAMU–Corpus Christi · Texas, USA</span>
      </div>
    </footer>
  </body>
</html>
