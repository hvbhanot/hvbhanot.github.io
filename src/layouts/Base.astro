---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: 'home' | 'thoughts';
}

const {
  title = 'Harsh Vardhan Bhanot — AI Systems & Research',
  description = 'CS undergrad at TAMU–Corpus Christi. Building AI systems, evolutionary simulation tooling, and ML-powered research infrastructure.',
  current = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d1421" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="brand" aria-label="Home">
          <span class="brand__name">Harsh Vardhan Bhanot</span>
          <span class="brand__role">Research &amp; AI Systems</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="/#about">About</a>
          <a href="/#focus">What I work on</a>
          <a href="/#work">Systems</a>
          <a href="/#experience">Trajectory</a>
          <a href="/thoughts" aria-current={current === 'thoughts' ? 'page' : undefined}>Journal</a>
        </nav>
        <div class="header-cta">
          <a href="https://github.com/hvbhanot" target="_blank" rel="noopener">GitHub</a>
          <a href="mailto:hvbhanot1@gmail.com" class="header-cta__login">
            Contact
            <span class="header-cta__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__inner">
          <div class="site-footer__brand">
            <span class="brand">
              <span class="brand__name">Harsh Vardhan Bhanot</span>
            </span>
            <p>Researcher and engineer working on AI systems for scientific computing — fine-tuned coding models, local multi-agent tooling, and reproducible infrastructure.</p>
          </div>
          <div class="site-footer__col">
            <h5>Sections</h5>
            <ul>
              <li><a href="/#about">About</a></li>
              <li><a href="/#focus">What I work on</a></li>
              <li><a href="/#work">Systems</a></li>
              <li><a href="/#experience">Trajectory</a></li>
              <li><a href="/#tools">Tools</a></li>
            </ul>
          </div>
          <div class="site-footer__col">
            <h5>Writing</h5>
            <ul>
              <li><a href="/thoughts">Journal</a></li>
              <li><a href="/thoughts">Notes</a></li>
              <li><a href="/thoughts">Post-mortems</a></li>
            </ul>
          </div>
          <div class="site-footer__col">
            <h5>Channels</h5>
            <ul>
              <li><a href="mailto:hvbhanot1@gmail.com">Email</a></li>
              <li><a href="https://github.com/hvbhanot" target="_blank" rel="noopener">GitHub</a></li>
              <li><a href="https://huggingface.co/hvbhanot" target="_blank" rel="noopener">Hugging Face</a></li>
              <li><a href="https://linkedin.com/in/hvbhanot" target="_blank" rel="noopener">LinkedIn</a></li>
            </ul>
          </div>
          <div class="site-footer__col">
            <h5>Affiliations</h5>
            <ul>
              <li><a href="https://www.tamucc.edu/" target="_blank" rel="noopener">TAMU–Corpus Christi</a></li>
              <li><a href="https://messerlab.org/slim/" target="_blank" rel="noopener">SLiM project</a></li>
              <li><a href="https://aisenate.pro" target="_blank" rel="noopener">AI Senate</a></li>
            </ul>
          </div>
        </div>

        <div class="site-footer__bottom">
          <span>© {new Date().getFullYear()} <b>Harsh Vardhan Bhanot</b>. All rights reserved.</span>
          <span>Corpus Christi, Texas, USA</span>
        </div>
      </div>
    </footer>
  </body>
</html>
